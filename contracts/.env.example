###############################################################################
### Copy to `contracts/.env` (gitignored) and fill in. DO NOT COMMIT IT.    ###
###############################################################################
#
# `forge` loads this file automatically from the directory it runs in, so these
# are read by `forge script` and `forge test` without exporting anything.
#
# WHAT IS DELIBERATELY NOT HERE: the deployer's private key.
# `Deploy.s.sol` calls `vm.startBroadcast()` with no argument, so the signer
# comes from the command line rather than from this file. Keep it in Foundry's
# encrypted keystore instead of in a file or in your shell history:
#
#   cast wallet import helico-deployer --interactive     # once, asks for the key
#   cast wallet list                                     # confirm it is there
#
# then pass `--account helico-deployer` to the deploy. Foundry asks for the
# password each time and the key never touches this file, `.bash_history`, or a
# process listing.

# --- the chain -------------------------------------------------------------
# Any Arbitrum One endpoint. The public one works for a deploy; the fork test
# suite is happier on a node of your own.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Only needed to run the fork suites that use them. `forge test` skips those
# when they are unset rather than failing.
BASE_RPC_URL=
MAINNET_RPC_URL=

# --- what Deploy.s.sol reads ----------------------------------------------
# REQUIRED. The enclave's signer: the address whose EIP-712 authorisations the
# vault will accept. The key behind it exists only inside the Confidential
# Workflow's TEE, which is the whole point of the signature path — so this is an
# address you read out of the enclave, never one whose key you hold.
AGENT_ADDRESS=

# Optional; defaults to the broadcaster. Holds DEFAULT_ADMIN_ROLE, which can
# grant roles and schedule upgrades. Should be a multisig on anything that
# matters.
ADMIN_ADDRESS=

# Optional. The Chainlink CRE KeystoneForwarder whose reports the vault honours.
# Left unset the report path is simply off, and an admin can point the vault at
# one later with `setForwarder` without redeploying — which is how the same
# deployment moves from the CLI's mock forwarder to the real one.
FORWARDER_ADDRESS=
