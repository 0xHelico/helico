###############################################################################
### Copy to `contracts/.env` (gitignored) and fill in. DO NOT COMMIT IT.    ###
###############################################################################
#
# `forge` loads this file automatically from the directory it runs in, so these
# are read by `forge script` and `forge test` without exporting anything.
#
# WHAT IS DELIBERATELY NOT HERE: the deployer's private key.
# Every deploy script calls `vm.startBroadcast()` with no argument, so the signer
# comes from the command line rather than from this file. Keep it in Foundry's
# encrypted keystore instead of in a file or in your shell history:
#
#   cast wallet import helico-deployer --interactive     # once, asks for the key
#   cast wallet list                                     # confirm it is there
#
# then pass `--account helico-deployer` to the deploy. Foundry asks for the
# password each time and the key never touches this file, `.bash_history`, or a
# process listing.

# --- the chain -------------------------------------------------------------
# Any Arbitrum One endpoint. The public one works for a deploy; the fork test
# suite is happier on a node of your own.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Only needed to run the fork suites that use them. `forge test` skips those
# when they are unset rather than failing.
BASE_RPC_URL=
MAINNET_RPC_URL=

# --- what the deploy scripts read -----------------------------------------
# All three are optional: every script reads them with `vm.envOr` and has a
# default, so a missing one is a different deployment rather than a failure.
# Addresses that have already been used are in `docs/deployments.md`.

# `DeployAccountFactory.s.sol`. The key allowed to upgrade accounts without the
# owner acting. It is an immutable on the implementation, so it cannot be
# changed later without shipping a new one. Left unset there is no upgrader and
# accounts can only be upgraded by their owner — which is the safer default and
# not the one we deployed with.
ACCOUNT_UPGRADER=

# `DeployMandateSwap.s.sol`. 1inch Aqua. Defaults to the mainnet deployment the
# script has compiled in, and the script refuses an address with no code, so
# this is here for forks rather than for production.
AQUA_ADDRESS=

# `DeploySwapVMRouter.s.sol`. May recover tokens stranded by a mandate shipped
# to the wrong router — it cannot touch anything a correct swap uses. Left unset
# there is no rescuer and stranded tokens stay stranded until `dock`.
SWAPVM_RESCUER=
