msg=$(head -n1 "$1")
case "$msg" in
	Merge\ *|Revert\ *) exit 0 ;;
esac
echo "$msg" | grep -qE '^(feat|fix|docs|refactor|test|chore|build|ci|perf)(\([a-z0-9./-]+\))?!?: [^ ].+' && exit 0
echo "Commit message must follow Conventional Commits: <type>(<scope>): <summary>" >&2
echo "Types: feat fix docs refactor test chore build ci perf" >&2
exit 1
