# Throwaway probes, so a broad `git add` cannot sweep one in.
*.tmp.ts
.env
.env.local
.env.*.local
.DS_Store
dist
build
out
cache
.next
*.log

# A trailing slash matches a directory only, so a *symlink* of the same name slips past the
# rule and gets committed. That happened twice in one afternoon — `node_modules` and
# `contracts/lib`, both symlinks made in a worktree to skip a reinstall, both carrying an
# absolute home path into a public repository. No trailing slashes here.

# Foundry
broadcast
artifacts

# CRE
.cre

# Turborepo
.turbo

# Astro generated types
.astro

# CRE simulator scratch files
.cre_build_tmp.*

# Foundry
contracts/out
contracts/cache
contracts/lib
# Written by `forge install`. It locks a directory that is not committed, against versions CI
# pins by hand in the workflow, so committing it would be a second source of truth nothing reads.
# Unanchored because the first one landed at the repo root, from an install run in the wrong
# directory — there is no foundry project there at all.
foundry.lock
contracts/out-swapvm
