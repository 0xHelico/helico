# Reown project id. Public by design: the browser sends it.
NEXT_PUBLIC_PROJECT_ID=8cc38dcdd178b28a332ffb9750248a9d

# The backend that turns a sentence into a checked swap intent.
BE_API_URL=https://api.helico.site

# Where the app reads Arbitrum One from. Unset uses the chain's public endpoint, which
# rate-limits under real traffic.
NEXT_PUBLIC_ARBITRUM_RPC_URL=

# The backend the browser talks to directly, for the session cookie and the saved
# conversations. The swap intent still goes through this app's own /api/chat route.
#
# Unset is now right for both runs: `next dev` defaults to `http://localhost:8787`, which is
# where `apps/be` listens, and a production build defaults to https://api.helico.site. Set this
# only to point somewhere else.
#
# Do not point a local page at https://api.helico.site. The session cookie is SameSite=Lax, so it only comes back on
# same-site requests, and `localhost` and `127.0.0.1` count as different sites. Pointing a local
# page at https://api.helico.site is genuinely cross-site: the sign-in will appear to work and
# the session will not survive a reload.
NEXT_PUBLIC_BE_API_URL=https://api.helico.site

# The account factory. Deployed on Arbitrum One on 8 September, and defaulted in
# `lib/account.ts` so a fresh clone reads it without being configured. Set this to override it,
# or to an empty string to see the not-deployed path, which is still rendered.
NEXT_PUBLIC_ACCOUNT_FACTORY=

# 1inch Business API, from https://business.1inch.com. Server-side only: the dapp reaches it
# through `/api/1inch/…`, a route handler that adds the header. Never give this a NEXT_PUBLIC_
# prefix — that inlines the value into the client bundle, and a bundled key is a public key.
# Without it the swap card still works on Aqua and refuses the fallback by name.
ONEINCH_API_KEY=
