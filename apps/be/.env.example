# Local configuration for `go run ./cmd/be`. Copy to `.env`; it is gitignored.
#
# The environment always wins over this file, so a deployment — which sets variables and never
# ships a file — is unaffected by anything written here.

# The model. Any OpenAI-compatible endpoint, which is what lets a 9router instance stand where
# api.openai.com used to: the shape is the same and only the address and the key change.
#
# Empty, or absent, and /api/swap/intent answers 503 and the model picker in the dapp reads
# "no model configured" — which is true, not a bug.
BE_LLM_BASE_URL=
BE_LLM_API_KEY=
BE_LLM_MODEL=
# Only for an endpoint behind an HTTP basic challenge. When these are set the key is sent as
# X-Api-Key instead, because one Authorization header cannot carry Basic and Bearer at once and
# the proxy in front answers first.
BE_LLM_USER=
BE_LLM_PASS=

# A second model, asked only when the first one fails. Same five variables; leave the key empty
# and there is no fallback, which is one model and not a broken one.
#
# Order is about latency rather than preference: put the quicker endpoint first. Both of ours
# answer correctly, and one of them takes five seconds longer.
BE_LLM_FALLBACK_BASE_URL=
BE_LLM_FALLBACK_API_KEY=
BE_LLM_FALLBACK_MODEL=
BE_LLM_FALLBACK_USER=
BE_LLM_FALLBACK_PASS=

# How long one model gets. The whole chain has to fit inside BE_REQUEST_TIMEOUT, so two models
# at 12s need more than 24s there; the process refuses to start on a combination that cannot
# work rather than timing out in a way that reads like an unset key.
# BE_LLM_TIMEOUT=12s
# BE_REQUEST_TIMEOUT=30s

# Signs the session cookie. Leave it empty: the process keeps a generated key beside the
# database, so a restart no longer signs you out.
BE_SESSION_SECRET=

# The dapp on :3000 and the browser checks on :3100 are already in the default list. Add an
# origin here only if you serve the frontend from somewhere else.
# BE_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# The subgraph POST /api/graph stands in front of, and how long an answer is kept.
# BE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/1758877/helico-arbitrum-one/version/latest
# BE_GRAPH_TTL=60s

# The chat reads the index through The Graph's Subgraph MCP when both of these are set. The
# server serves subgraphs on The Graph Network, not Studio deployments, so the id is the one
# Studio shows after "Publish". Leave both empty and the status answer is what it always was.
BE_GRAPH_MCP_URL=
BE_GRAPH_MCP_SUBGRAPH_ID=
# Optional. Sent as a Bearer token; the server answers without it.
BE_GRAPH_MCP_API_KEY=
