---
interface Props {
	title: string
	description?: string
}

const { title, description = 'Helico, an ETHOnline 2026 submission.' } = Astro.props
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		font-family: system-ui, sans-serif;
		line-height: 1.5;
		color: #111;
		background: #fff;
	}
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}
</style>
