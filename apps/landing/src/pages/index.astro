---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import { HeroCanvas } from '../components/canvas/HeroCanvas'
import Base from '../layouts/Base.astro'

const repo = 'https://github.com/0xHelico/helico'
---

<Base title="Helico">
	<div class="root">
		<div class="aurora" aria-hidden="true">
			<div class="aurora__zoom" id="bg-zoom">
				<div class="aurora__blob aurora__blob--a"></div>
				<div class="aurora__blob aurora__blob--b"></div>
				<div class="aurora__blob aurora__blob--c"></div>
				<div class="aurora__grain"></div>
			</div>
		</div>

		<nav class="nav" aria-label="Primary">
			<div class="nav__pill">
				<a href="#hero" class="nav__logo" aria-label="Helico home">
					<Image src={logo} alt="" width={28} height={28} densities={[1, 2]} loading="eager" />
				</a>
				<div class="nav__links">
					<a href="#hero">Product</a>
					<a href="#canvas">How it works</a>
					<a href={`${repo}#readme`}>Evidence</a>
					<a href={repo}>GitHub</a>
				</div>
				<a class="gradient-border-btn" href="#canvas">Get started</a>
			</div>
		</nav>

		<div class="layer">
			<section class="hero" id="hero">
				<h1>
					<span class="muted">A New Way</span><br />to Keep Your<br />Liquidity in Range
				</h1>
				<p>
					Commit a mandate once. A Chainlink CRE enclave watches your Uniswap v4 position and decides
					when to re-centre. The vault refuses anything outside what you signed.
				</p>
				<div class="hero__cta">
					<a class="cta" href={`${repo}#readme`}>
						Getting started
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
					</a>
					<span class="hero__note">ETHOnline 2026 · Arbitrum One · open source</span>
				</div>
			</section>

			<section class="showcase" id="canvas">
				<div class="showcase__head">
					<span class="eyebrow">Behind the chat</span>
					<h2>Your mandate, enforced by the chain</h2>
					<p>
						Four things that happen when the enclave watches a position: it commits your terms, brings the
						position back in range, refuses thresholds you did not sign, and holds when there is nothing to do.
						Illustrative, with the numbers the repository recorded.
					</p>
				</div>
				<HeroCanvas client:visible />
			</section>

			<footer class="footer">
				<span>Helico · an ETHOnline 2026 submission</span>
				<span><a href={repo}>Source on GitHub</a> · <a href={`${repo}/blob/main/FEEDBACK.md`}>Uniswap feedback</a></span>
			</footer>
		</div>
	</div>
</Base>

<style>
	.root {
		min-height: 200vh;
	}

	/* fixed background: an aurora in the logo's palette, zooming as the page scrolls */
	.aurora {
		position: fixed;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
		background: #f7f9ff;
	}
	.aurora__zoom {
		position: absolute;
		inset: 0;
		transform-origin: center center;
		will-change: transform;
	}
	.aurora__blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(70px);
		opacity: 0.85;
		animation: drift 18s ease-in-out infinite alternate;
	}
	.aurora__blob--a {
		width: 60vmax;
		height: 60vmax;
		left: -12vmax;
		top: -18vmax;
		background: radial-gradient(circle at 40% 40%, #9dbbff, #5b8cff 45%, transparent 70%);
	}
	.aurora__blob--b {
		width: 55vmax;
		height: 55vmax;
		right: -14vmax;
		top: 6vmax;
		background: radial-gradient(circle at 50% 50%, #c9b8ff, #8b7cf6 45%, transparent 72%);
		animation-delay: -6s;
	}
	.aurora__blob--c {
		width: 50vmax;
		height: 50vmax;
		left: 22vmax;
		bottom: -22vmax;
		background: radial-gradient(circle at 50% 50%, #ffd6f2, #e59bd8 45%, transparent 72%);
		animation-delay: -12s;
	}
	.aurora__grain {
		position: absolute;
		inset: 0;
		background: radial-gradient(120% 80% at 50% 0%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 60%);
	}
	@keyframes drift {
		from {
			transform: translate3d(0, 0, 0) scale(1);
		}
		to {
			transform: translate3d(6vmax, 4vmax, 0) scale(1.12);
		}
	}

	/* nav */
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: flex;
		justify-content: center;
		padding: 1.5rem 1.5rem 0;
	}
	.nav__pill {
		display: flex;
		align-items: center;
		gap: 1rem;
		background: rgba(255, 255, 255, 0.7);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		border: 1px solid rgba(229, 231, 235, 0.8);
		border-radius: 9999px;
		padding: 0.625rem 0.625rem 0.625rem 1rem;
		box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
	}
	.nav__logo {
		width: 28px;
		height: 28px;
		display: block;
		border-radius: 50%;
		overflow: hidden;
	}
	.nav__links {
		display: none;
		align-items: center;
		gap: 1.75rem;
	}
	.nav__links a {
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 500;
		color: #4b5563;
		transition: color 0.15s;
	}
	.nav__links a:hover {
		color: #111827;
	}
	.gradient-border-btn {
		position: relative;
		background: #fff;
		border: 0;
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 600;
		color: #111827;
		border-radius: 9999px;
		padding: 0.5rem 1.25rem;
		box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
		transition: background-color 0.15s;
	}
	.gradient-border-btn:hover {
		background: #f9fafb;
	}
	.gradient-border-btn::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1.5px;
		background: linear-gradient(135deg, #3b82f6, #8b7cf6, #e59bd8);
		-webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}
	@media (min-width: 768px) {
		.nav__pill {
			gap: 2rem;
			padding-left: 1.25rem;
		}
		.nav__links {
			display: flex;
		}
	}

	.layer {
		position: relative;
		z-index: 10;
	}

	/* hero */
	.hero {
		position: relative;
		z-index: 10;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		padding: 8rem 1rem 0;
		text-align: center;
		min-height: 100vh;
		will-change: transform;
	}
	.hero h1 {
		margin: 0;
		font-size: 2.25rem;
		line-height: 1;
		letter-spacing: -0.05em;
		font-weight: 500;
		color: #111827;
		max-width: 42rem;
	}
	.hero h1 .muted {
		color: #8a90a0;
	}
	.hero p {
		margin: 2rem 0 0;
		font-size: 1rem;
		line-height: 1.625;
		color: #4e5560;
		max-width: 30rem;
	}
	.hero__cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.875rem;
		margin-top: 2.5rem;
		animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: #0b0e15;
		color: #fff;
		font-weight: 600;
		font-size: 0.95rem;
		border-radius: 9999px;
		padding: 0.8rem 1.4rem 0.8rem 1.6rem;
		box-shadow: 0 10px 30px -12px rgba(11, 14, 21, 0.6);
		transition: transform 0.15s, box-shadow 0.15s;
	}
	.cta:hover {
		transform: translateY(-1px);
		box-shadow: 0 14px 34px -12px rgba(11, 14, 21, 0.65);
	}
	.cta svg {
		width: 1rem;
		height: 1rem;
	}
	.hero__note {
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: #868d99;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(16px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}
	@media (min-width: 640px) {
		.hero {
			padding: 9rem 1.5rem 0;
		}
		.hero h1 {
			font-size: 3rem;
		}
		.hero__cta {
			margin-top: 3.5rem;
		}
	}
	@media (min-width: 768px) {
		.hero {
			padding-top: 10rem;
		}
		.hero h1 {
			font-size: 3.75rem;
		}
	}

	/* canvas section */
	.showcase {
		position: relative;
		z-index: 20;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 2rem 1rem 5rem;
		max-width: 80rem;
		margin: 0 auto;
		will-change: transform;
		transform-origin: center top;
	}
	.showcase__head {
		text-align: center;
		margin: 0 auto 1.75rem;
		max-width: 40rem;
	}
	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #868d99;
	}
	.showcase__head h2 {
		margin: 0.75rem 0 0;
		font-size: 1.75rem;
		line-height: 1.15;
		letter-spacing: -0.04em;
		font-weight: 500;
		color: #111827;
	}
	.showcase__head p {
		margin: 1rem 0 0;
		font-size: 0.925rem;
		line-height: 1.6;
		color: #4e5560;
	}
	@media (min-width: 768px) {
		.showcase {
			padding: 2rem 4rem 6rem;
		}
		.showcase__head h2 {
			font-size: 2.5rem;
		}
	}
	@media (min-width: 1024px) {
		.showcase {
			padding: 2rem 6rem 6rem;
		}
	}

	.footer {
		position: relative;
		z-index: 10;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding: 1.5rem 2rem 2.5rem;
		font-size: 0.8rem;
		color: #868d99;
	}
	.footer a {
		color: #4e5560;
	}
	.footer a:hover {
		color: #111827;
	}

	@media (prefers-reduced-motion: reduce) {
		.aurora__blob,
		.hero__cta {
			animation: none;
		}
	}
</style>

<script>
	// Scroll-linked transforms: the aurora zooms, the hero fades and lifts, the canvas scales in.
	const bg = document.getElementById('bg-zoom')
	const hero = document.getElementById('hero')
	const show = document.getElementById('canvas')
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
	let raf = 0
	const clamp = (v: number, a: number, b: number) => Math.min(Math.max(v, a), b)
	function update() {
		raf = 0
		if (!bg || !hero || !show) return
		const p = Math.min(window.scrollY / window.innerHeight, 1)
		bg.style.transform = `scale(${1 + p * 0.3})`
		const o = Math.max(1 - p * 2.5, 0)
		hero.style.opacity = String(o)
		hero.style.transform = `translateY(${p * -60}px)`
		hero.style.pointerEvents = o < 0.1 ? 'none' : 'auto'
		const t = clamp((p - 0.35) / (0.75 - 0.35), 0, 1)
		show.style.opacity = String(t)
		show.style.transform = `scale(${0.88 + t * 0.12})`
	}
	function onScroll() {
		if (!raf) raf = requestAnimationFrame(update)
	}
	if (!reduce) {
		update()
		window.addEventListener('scroll', onScroll, { passive: true })
		window.addEventListener('resize', onScroll)
	}
</script>
