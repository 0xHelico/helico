---
import { Image } from 'astro:assets'
import logo from '../../assets/logo.webp'
const repo = 'https://github.com/0xHelico/helico'
const x = 'https://x.com/0xhelico'
const columns = [
	{ title: 'Product', links: [['Vault', `${repo}/tree/main/contracts`], ['Plugins', `${repo}/tree/main/packages/plugins`], ['Evidence', '/#verified']] },
	{ title: 'Developers', links: [['GitHub', repo], ['Plans', `${repo}/tree/main/docs/plans`], ['AI usage', `${repo}/blob/main/AI-USAGE.md`], ['Contributing', `${repo}/blob/main/CONTRIBUTING.md`]] },
	{ title: 'Resources', links: [['Blog', '/blog/'], ['README', `${repo}#readme`], ['Uniswap feedback', `${repo}/blob/main/FEEDBACK.md`], ['FAQ', '/#faq']] },
	{ title: 'Project', links: [['ETHOnline 2026', 'https://ethglobal.com/events/ethonline2026'], ['MIT license', `${repo}/blob/main/LICENSE`]] },
]
---

<div class="wrap">
	<div class="section-card closing">
		<section class="section-card section-card--white center updates" aria-label="Stay updated">
			<h2>Stay Updated</h2>
			<p>Be the first to hear when the vault goes live.</p>
			<div class="updates__actions">
				<a class="btn btn--ink" href={x} target="_blank" rel="noreferrer">Follow on X</a>
			</div>
		</section>

		<footer class="footer">
			<div class="footer__grid">
				{columns.map((c) => (
					<div class="footer__col">
						<h3>{c.title}</h3>
						<ul>{c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
					</div>
				))}
			</div>
			<div class="footer__brand-row">
				<a class="footer__brand" href="/" aria-label="Helico, back to top">
					<Image src={logo} alt="" width={28} height={28} densities={[1, 2]} />
					<span>helico</span>
				</a>
				<div class="footer__social">
					<a href={x} target="_blank" rel="noreferrer" aria-label="Helico on X">
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.4 8.5L23 22h-6.8l-5.3-6.9L4.8 22H1.6l7.9-9L0 2h7l4.8 6.3L18.9 2zm-1.2 18h1.9L6.4 3.9H4.4L17.7 20z" /></svg>
					</a>
					<a href={repo} target="_blank" rel="noreferrer" aria-label="Helico on GitHub">
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z" /></svg>
					</a>
				</div>
			</div>
			<p class="footer__legal">
				Helico is a hackathon submission built for ETHOnline 2026. Nothing on this page is financial
				advice. The vault has not been audited for production use, and the scenarios shown are
				illustrative, using numbers recorded in the repository. Nothing is deployed to a live network
				yet.
			</p>
		</footer>
	</div>
</div>

<style>
	.closing {
		padding-top: 1.5rem;
		padding-bottom: 2.5rem;
		/* The card does not touch the bottom of the page; the same gutter as its sides. */
		margin-bottom: var(--gutter);
	}
	.updates h2 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 450;
		line-height: 1.35;
		letter-spacing: -0.03em;
		color: var(--ink-solid);
	}
	.updates p {
		margin: 0.5rem auto 1.5rem;
		max-width: 620px;
		font-size: 1.25rem;
		line-height: 1.36;
		letter-spacing: -0.01em;
		color: var(--ink-65);
	}
	.footer {
		max-width: var(--content-max);
		margin: clamp(3rem, 7vw, 6rem) auto 0;
	}
	.footer__grid {
		display: grid;
		gap: 2rem 1.5rem;
		grid-template-columns: repeat(2, 1fr);
	}
	.footer__col h3 {
		margin: 0 0 1rem;
		font-size: 0.875rem;
		font-weight: 450;
		letter-spacing: 0.01em;
		color: var(--lav-text);
	}
	.footer__col ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.75rem;
	}
	.footer__col a {
		font-size: 0.875rem;
		font-weight: 450;
		line-height: 1.25;
		color: var(--ink-65);
	}
	.footer__col a:hover {
		color: var(--ink-90);
	}
	.footer__brand-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: clamp(3rem, 6vw, 5rem);
	}
	.footer__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 550;
		letter-spacing: -0.02em;
		color: var(--lav-text);
	}
	.updates__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}
	.updates__actions .btn {
		height: 42px;
		padding: 8px 16px;
		font-size: 1rem;
		font-weight: 450;
	}
	.footer__social {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.footer__social a {
		display: inline-flex;
		color: rgba(39, 34, 40, 0.4);
	}
	.footer__social a:hover {
		color: var(--ink-90);
	}
	.footer__social svg {
		width: 1.35rem;
		height: 1.35rem;
	}
	.footer__legal {
		margin: clamp(2.5rem, 5vw, 4rem) 0 0;
		font-size: 0.875rem;
		line-height: 1.6;
		letter-spacing: -0.01em;
		color: rgba(39, 34, 40, 0.5);
	}
	@media (min-width: 768px) {
		.footer__grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
