---
const repo = 'https://github.com/0xHelico/helico'
const vault = `${repo}/blob/154bcabd85ca3be8f73851bbc55a1a04ea42c6e4/contracts/src/HelicoVault.sol`
import { readFileSync } from 'node:fs'
// Read from the vault source at build time, so the page shows the function as this checkout has it.
const source = readFileSync(new URL('../../../../../contracts/src/HelicoVault.sol', import.meta.url), 'utf8')
const from = source.indexOf('    function _checkRange(')
const to = source.indexOf('\n    }\n', from) + '\n    }'.length
const check = source.slice(from, to).replace(/^ {4}/gm, '')
const proofs = [
	{
		title: 'Source',
		copy: 'MIT licensed, with every plan, prompt, and AI-usage note committed next to the code.',
		cta: 'Read the vault',
		href: `${repo}/blob/main/contracts/src/HelicoVault.sol`,
	},
	{
		title: 'Fork tests',
		copy: 'Nine tests mint, swap, and re-centre through the real PoolManager on a fork of Arbitrum One. CI skips them without an RPC, and says so.',
		cta: 'The swap test',
		href: `${repo}/blob/main/contracts/test/ForkSwapRecentre.t.sol`,
	},
	{
		title: 'Deployment',
		copy: 'A deploy script with a wrong-chain guard, rehearsed on a fork. Nothing is on a live network yet; the address will be here when it is.',
		cta: 'The deploy script',
		href: `${repo}/blob/main/contracts/script/Deploy.s.sol`,
	},
]
---

<section class="wrap open" id="open" aria-labelledby="open-title">
	<div class="section-card center">
		<span class="eyebrow">Open by default</span>
		<h2 class="headline" id="open-title">The check is twenty lines. Read it.</h2>
		<p class="lede">This is the function the vault runs on every proposed range, exactly as the vault has it.</p>
		<div class="actions">
			<a class="btn btn--secondary" href={`${vault}#L724`}>Open on GitHub</a>
		</div>
		<figure class="code">
			<figcaption>contracts/src/HelicoVault.sol · <code>_checkRange</code></figcaption>
			<pre tabindex="0"><code>{check}</code></pre>
		</figure>
		<div class="cards" style="text-align:left">
			{proofs.map((p) => (
				<div class="card">
					<h3>{p.title}</h3>
					<p>{p.copy}</p>
					<a class="card__link" href={p.href}>{p.cta} ↗</a>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.open {
		margin-top: 2rem;
	}
	.code {
		margin: clamp(2rem, 4vw, 3rem) auto 1.5rem;
		max-width: 60rem;
		text-align: left;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid rgba(11, 14, 21, 0.1);
		background: #0b0b10;
		color: #e6e4f2;
		box-shadow: 0 40px 80px -40px rgba(93, 76, 230, 0.35);
	}
	.code figcaption {
		padding: 0.7rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: #9a98ad;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.code figcaption code {
		color: #b7abff;
	}
	.code pre {
		margin: 0;
		padding: 1.1rem 1.25rem;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.6;
		tab-size: 4;
		/* Verbatim means verbatim: no ligatures turning >= into one glyph. */
		font-variant-ligatures: none;
	}
	.card__link {
		display: inline-block;
		margin-top: 0.75rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: #5d4ce6;
	}
</style>
