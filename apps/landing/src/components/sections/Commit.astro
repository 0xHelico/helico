---
const repo = 'https://github.com/0xHelico/helico'
---

<section class="wrap commit" aria-labelledby="commit-title">
	<div class="section-card center">
		<h2 class="headline" id="commit-title">Commit a mandate.</h2>
		<p class="lede">Seven fields, signed once. The enclave does the watching; the vault does the refusing.</p>
		<div class="actions">
			<a class="btn btn--primary" href={`${repo}#readme`}>Read the docs</a>
			<a class="btn btn--secondary" href={`${repo}/tree/main/docs/plans`}>See the plans</a>
		</div>
	</div>
</section>

<style>
	.commit {
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}
</style>
