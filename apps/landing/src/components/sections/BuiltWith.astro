---
const stack = ['Uniswap v4', 'Chainlink CRE', 'Arbitrum One', 'Foundry', 'Bun']
---

<section class="wrap built" aria-label="Built with">
	<p class="built__label">Built with</p>
	<ul class="built__list">{stack.map((s) => <li>{s}</li>)}</ul>
</section>

<style>
	.built {
		max-width: var(--content-max);
		margin-top: 2.5rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem 1.5rem;
	}
	.built__label {
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6b7280;
	}
	.built__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.built__list li {
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 600;
		color: #2b3140;
	}
</style>
