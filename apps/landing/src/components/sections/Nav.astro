type Item = { title: string; sub: string; href: string; icon: keyof typeof icons; badge?: string; external?: boolean }
type Menu = { id: string; label: string; items: Item[] }

const menus: Menu[] = [
	{
		id: 'product',
		label: 'Product',
		items: [
			{ title: 'Helico Vault', sub: 'Keeps your deposit earning', href: '/#hero', icon: 'bank' },
			{ title: 'Mandate', badge: '7 fields', sub: 'Seven rules you write once', href: '/#enforcement', icon: 'document' },
			{ title: 'Live canvas', sub: 'Watch a move happen', href: '/#canvas', icon: 'layers' },
		],
	},
	{
		id: 'how',
		label: 'How It Works',
		items: [
			{ title: 'The mandate', sub: 'What you decide, and what the contract enforces', href: '/#enforcement', icon: 'document' },
			{ title: 'The enclave', sub: 'The sealed program that decides', href: `${repo}/tree/main/packages/plugins/cre`, icon: 'leaf', external: true },
			{ title: 'The check', sub: 'The actual code, for builders', href: '/#build', icon: 'book' },
		],
	},
	{
		id: 'developers',
		label: 'Developers',
		items: [
			{ title: 'Uniswap plugin', badge: '52 tests', sub: 'Pools and positions from the SDK', href: `${repo}/tree/main/packages/plugins/uniswap`, icon: 'percent', external: true },
			{ title: 'CRE plugin', badge: '116 tests', sub: 'Decide, size, and sign in the enclave', href: `${repo}/tree/main/packages/plugins/cre`, icon: 'pills', external: true },
			{ title: 'Vault', badge: `${solidityTests} tests`, sub: 'Solidity, Foundry, fork tests', href: `${repo}/tree/main/contracts`, icon: 'coins', external: true },
			{ title: 'Plans and prompts', sub: 'Every plan committed before code', href: `${repo}/tree/main/docs/plans`, icon: 'bars', external: true },
		],
	},
	{
		id: 'evidence',
		label: 'Evidence',
		items: [
			{ title: 'Verified by default', sub: 'Tests and records, nothing else', href: '/#verified', icon: 'scales' },
			{ title: 'AI usage', sub: 'What was AI-assisted, and how', href: `${repo}/blob/main/AI-USAGE.md`, icon: 'arcs', external: true },
			{ title: 'Uniswap feedback', sub: 'FEEDBACK.md for the Foundation', href: `${repo}/blob/main/FEEDBACK.md`, icon: 'wings', external: true },
		],
	},
]
---

<header class="nav" data-nav>
	<div class="wrap nav__inner">
		<a class="nav__brand" href="/" aria-label="Helico, back to top">
			<Image src={logoNav} alt="" width={28} height={28} densities={[1, 2]} />
			<span>helico</span>
		</a>
		<div class="nav__right">
			<nav class="nav__links" aria-label="Primary">
				{menus.map((m) => (
					<button type="button" data-menu={m.id} aria-expanded="false" aria-controls={`menu-${m.id}`}>{m.label}</button>
				))}
				<a href="/#faq">FAQ</a>
				<a href="/blog/">Blog</a>
			</nav>
			<a class="btn btn--ink btn--small nav__cta" href={repo}>Get Started</a>
			<button type="button" class="nav__burger" data-burger aria-expanded="false" aria-controls="nav-sheet" aria-label="Open menu">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
			</button>
		</div>
	</div>
	{menus.map((m) => (
		<div class="nav__panel" id={`menu-${m.id}`} data-panel={m.id}>
			<div class="nav__panel-wrap">
			<div class="nav__grid">
				{m.items.map((it) => (
					<a class="nav__card" href={it.href} {...(it.external ? { target: '_blank', rel: 'noreferrer' } : {})}>
						<span class="nav__icon" aria-hidden="true">
							<svg viewBox="0 0 40 40" fill="none" set:html={icons[it.icon]} />
						</span>
						<span class="nav__text">
							<span class="nav__title">{it.title}{it.badge && <em>{it.badge}</em>}</span>
							<span class="nav__sub">{it.sub}</span>
						</span>
						{it.external && (
							<svg class="nav__ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
						)}
					</a>
				))}
			</div>
			</div>
		</div>
	))}
</header>

<div class="nav__sheet" id="nav-sheet" data-sheet role="dialog" aria-modal="true" aria-label="Menu" hidden>
	<div class="nav__sheet-top">
		<a class="nav__brand" href="/" aria-label="Helico, back to top" data-sheet-link>
			<Image src={logoNav} alt="" width={28} height={28} densities={[1, 2]} />
			<span>helico</span>
		</a>
		<button type="button" class="nav__burger" data-sheet-close aria-label="Close menu">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
		</button>
	</div>
	{menus.map((m) => (
		<section class="nav__group" aria-labelledby={`sheet-${m.id}`}>
			<h2 id={`sheet-${m.id}`}>{m.label}</h2>
			<div class="nav__list">
				{m.items.map((it) => (
					<a class="nav__card nav__card--sheet" href={it.href} data-sheet-link {...(it.external ? { target: '_blank', rel: 'noreferrer' } : {})}>
						<span class="nav__icon" aria-hidden="true">
							<svg viewBox="0 0 40 40" fill="none" set:html={icons[it.icon]} />
						</span>
						<span class="nav__text">
							<span class="nav__title">{it.title}{it.badge && <em>{it.badge}</em>}</span>
							<span class="nav__sub">{it.sub}</span>
						</span>
						{it.external && (
							<svg class="nav__ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
						)}
					</a>
				))}
			</div>
		</section>
	))}
	<section class="nav__group nav__group--foot">
		<a class="nav__card nav__card--sheet" href="/#faq" data-sheet-link>
			<span class="nav__text"><span class="nav__title">FAQ</span><span class="nav__sub">Six questions, answered honestly</span></span>
		</a>
		<a class="nav__card nav__card--sheet" href="/blog/" data-sheet-link>
			<span class="nav__text"><span class="nav__title">Blog</span><span class="nav__sub">Notes from building Helico</span></span>
		</a>
		<a class="btn btn--ink" href={repo} data-sheet-link>Get Started</a>
	</section>
</div>

<script>
	// Hover opens on pointer devices, focus and click open everywhere, Escape and leaving close.
	const nav = document.querySelector<HTMLElement>('[data-nav]')
	const buttons = Array.from(nav?.querySelectorAll<HTMLButtonElement>('[data-menu]') ?? [])
	const panels = Array.from(nav?.querySelectorAll<HTMLElement>('[data-panel]') ?? [])
	const hoverable = window.matchMedia('(hover: hover)').matches
	let current: string | null = null
	const set = (id: string | null) => {
		current = id
		for (const b of buttons) b.setAttribute('aria-expanded', String(b.dataset.menu === id))
		for (const p of panels) p.toggleAttribute('data-open', p.dataset.panel === id)
		nav?.toggleAttribute('data-open', id !== null)
	}
	for (const b of buttons) {
		const id = b.dataset.menu ?? null
		b.addEventListener('click', () => set(current === id ? null : id))
		b.addEventListener('focus', () => set(id))
		if (hoverable) b.addEventListener('pointerenter', () => set(id))
	}
	if (hoverable) nav?.addEventListener('pointerleave', () => set(null))
	nav?.addEventListener('focusout', (e) => {
		if (!(e.relatedTarget instanceof Node) || !nav.contains(e.relatedTarget)) set(null)
	})
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape' || current === null) return
		const open = buttons.find((b) => b.dataset.menu === current)
		set(null)
		open?.focus()
	})
	document.addEventListener('pointerdown', (e) => {
		if (current !== null && e.target instanceof Node && !nav?.contains(e.target)) set(null)
	})

	// Transparent over the hero, a shorter white bar once the page has scrolled, like the reference.
	const onScroll = () => nav?.toggleAttribute('data-scrolled', window.scrollY > 8)
	window.addEventListener('scroll', onScroll, { passive: true })
	onScroll()

	// The small-screen sheet: the burger opens it, the cross, Escape, a link, or a wide viewport close it.
	const sheet = document.querySelector<HTMLElement>('[data-sheet]')
	const burger = document.querySelector<HTMLButtonElement>('[data-burger]')
	const closeBtn = sheet?.querySelector<HTMLButtonElement>('[data-sheet-close]')
	const openSheet = (open: boolean) => {
		if (!sheet || !burger) return
		sheet.hidden = !open
		burger.setAttribute('aria-expanded', String(open))
		document.documentElement.style.overflow = open ? 'hidden' : ''
		if (open) closeBtn?.focus()
		else burger.focus()
	}
	burger?.addEventListener('click', () => openSheet(sheet?.hidden ?? true))
	closeBtn?.addEventListener('click', () => openSheet(false))
	for (const a of sheet?.querySelectorAll('[data-sheet-link]') ?? []) a.addEventListener('click', () => openSheet(false))
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && sheet && !sheet.hidden) openSheet(false)
	})
	window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
		if (e.matches && sheet && !sheet.hidden) openSheet(false)
