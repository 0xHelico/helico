---
import { Image } from 'astro:assets'
import logo from '../../assets/logo.png'
const repo = 'https://github.com/0xHelico/helico'
---

<header class="nav">
	<div class="wrap nav__inner">
		<a href="#hero" class="nav__brand" aria-label="Helico home">
			<Image src={logo} alt="" width={24} height={24} densities={[1, 2]} loading="eager" />
			<span>helico</span>
		</a>
		<nav class="nav__links" aria-label="Primary">
			<a href="#hero">Product</a>
			<a href="#enforcement">How It Works</a>
			<a href="#build">Developers</a>
			<a href="#verified">Evidence</a>
			<a href="#faq">FAQ</a>
		</nav>
		<a class="btn btn--ink btn--small nav__cta" href={repo}>Get Started</a>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.85);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}
	.nav__inner {
		max-width: var(--content-max);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 82px;
	}
	.nav__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}
	.nav__brand img {
		border-radius: 50%;
	}
	.nav__links {
		display: none;
		gap: 0.25rem;
		font-size: 0.875rem;
		font-weight: 450;
		color: var(--ink-65);
	}
	.nav__links a {
		display: inline-flex;
		align-items: center;
		height: 32px;
		padding: 0 16px;
		border-radius: 50px;
	}
	.nav__links a:hover {
		color: var(--ink-90);
		background: rgba(37, 34, 40, 0.04);
	}
	@media (min-width: 900px) {
		.nav__links {
			display: flex;
		}
	}
</style>
