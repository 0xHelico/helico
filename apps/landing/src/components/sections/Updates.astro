---
const watch = 'https://github.com/0xHelico/helico/subscription'
---

<section class="wrap" aria-label="Stay updated">
	<div class="section-card section-card--white center updates">
		<h2>Stay Updated</h2>
		<p>Be the first to hear when the vault goes live.</p>
		<a class="btn btn--ink" href={watch}>Watch on GitHub</a>
	</div>
</section>

<style>
	.updates h2 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 450;
		line-height: 1.35;
		letter-spacing: -0.03em;
		color: var(--ink-solid);
	}
	.updates p {
		margin: 0.5rem auto 1.5rem;
		max-width: 620px;
		font-size: 1.25rem;
		line-height: 1.36;
		letter-spacing: -0.01em;
		color: var(--ink-65);
	}
</style>
