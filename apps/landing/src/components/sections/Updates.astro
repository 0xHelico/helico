---
const watch = 'https://github.com/0xHelico/helico/subscription'
---

<section class="wrap updates" aria-label="Follow the build">
	<div class="updates__card">
		<h2>Follow the build</h2>
		<p>Helico ships in the open. Watch the repository to hear when the vault goes live.</p>
		<a class="btn btn--ink" href={watch}>Watch on GitHub</a>
	</div>
</section>

<style>
	.updates {
		margin-top: 2rem;
	}
	.updates__card {
		max-width: 26rem;
		margin-inline: auto;
		text-align: center;
	}
	.updates__card h2 {
		margin: 0;
		font-size: 1.25rem;
		letter-spacing: -0.02em;
	}
	.updates__card p {
		margin: 0.5rem 0 1.1rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: #5b6270;
	}
</style>
