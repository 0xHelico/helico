---
const repo = 'https://github.com/0xHelico/helico'
// Permalinks pinned at the commit these line numbers were read from, so they stay true when the file moves on.
const vault = `${repo}/blob/154bcabd85ca3be8f73851bbc55a1a04ea42c6e4/contracts/src/HelicoVault.sol`
const fields = [
	{ field: 'poolId', value: 'ETH / ARB 0.05%', rule: 'Only the pool you named.', line: 489 },
	{ field: 'rangeWidthTicks', value: '20 ticks', rule: 'Exactly this width, on the pool\'s spacing.', line: 733 },
	{ field: 'minImprovementBps', value: '≥ 50 bps', rule: 'The new range must sit closer to the price by this much.', line: 747 },
	{ field: 'cooldownSeconds', value: '1 h', rule: 'One move per cooldown.', line: 473 },
	{ field: 'maxLiquidity', value: '1e18', rule: 'A cap on what one move may touch.', line: 486 },
	{ field: 'expiry', value: 'in 30 d', rule: 'After this, every re-centre reverts.', line: 468 },
	{ field: 'minRetainedBps', value: '≥ 90%', rule: 'The share a move must keep, read back from the mint.', line: 718 },
	{ field: 'the price', value: 'tick inside', rule: 'The new range must contain the current tick.', line: 739 },
]
const templates = [
	{
		label: 'Keep in range',
		name: 'Tight',
		copy: 'A narrow band around the price, moved often. Most fees, most re-centres.',
		chips: ['20 ticks', 'retain 90%', 'cooldown 1 h'],
	},
	{
		label: 'Wide and patient',
		name: 'Steady',
		copy: 'A wide band that only moves when the price has clearly left it.',
		chips: ['200 ticks', 'retain 95%', 'cooldown 24 h'],
	},
	{
		label: 'Hands off',
		name: 'Guarded',
		copy: 'Hold unless the improvement is worth the swap, and keep almost all of the position when it is.',
		chips: ['improve ≥ 50 bps', 'retain 95%', 'cooldown 12 h'],
	},
]
---

<section class="wrap" id="enforcement" aria-labelledby="enforcement-title">
	<div class="section-card section-card--dark center">
		<span class="eyebrow">Helico Mandate</span>
		<h2 class="headline" id="enforcement-title">The Full Power of the Mandate</h2>
		<p class="lede">Decide in the enclave, refuse on chain. Built on Uniswap v4.</p>
		<div class="actions">
			<a class="btn btn--dark" href={`${repo}#readme`}>Get Started</a>
			<a class="btn btn--ghost" href={`${vault}#L724`}>Learn More</a>
		</div>

		<div class="panel" aria-label="An example mandate and the rule the vault enforces for each field">
			<div class="panel__bar"><i></i><i></i><i></i><span>helico · vault · Arbitrum One · not deployed yet</span></div>
			<div class="panel__body">
				<div class="panel__side">
					<span class="is-active">Mandate</span><span>Position</span><span>Enclave</span><span>Vault</span><span>Evidence</span>
				</div>
				<div class="panel__main">
					<div class="panel__head">
						<div>
							<div class="panel__title">Mandate · example position</div>
							<div class="panel__sub">ETH / ARB 0.05% · Uniswap v4 · hash 0x134be6bb…6225</div>
						</div>
						<span class="panel__badge">example</span>
					</div>
					<ol class="fields">
						{fields.map((f) => (
							<li>
								<span class="fields__name"><code>{f.field}</code><b>{f.value}</b></span>
								<span class="fields__rule">{f.rule}</span>
								<a class="fields__line" href={`${vault}#L${f.line}`}>line {f.line} ↗</a>
							</li>
						))}
					</ol>
					<p class="fields__foot">Seven fields, one extra rule for the price. A re-centre that fails any of them reverts; there is no other entry point.</p>
				</div>
			</div>
		</div>
		<p class="panel__caption">Illustrative. Nothing is deployed yet; the fields are the seven the vault stores.</p>

		<div class="split">
			<div>
				<h3>A mandate for every strategy.</h3>
				<p>From a tight band that moves often to a wide one that waits, the terms are yours; the enclave chooses inside them and the vault refuses the rest.</p>
			</div>
			<a class="btn btn--ghost" href={`${repo}/blob/main/contracts/README.md`}>Learn More</a>
		</div>
		<div class="cards" style="text-align:left">
			{templates.map((t) => (
				<div class="card">
					<span class="label">{t.label}</span>
					<h3>{t.name}</h3>
					<p>{t.copy}</p>
					<div class="chips">{t.chips.map((c) => <span class="chip"><i></i>{c}</span>)}</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.enforcement {
		margin-top: 2rem;
	}
	.panel {
		margin: clamp(2rem, 4vw, 3rem) auto 0;
		max-width: 60rem;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: #101017;
		text-align: left;
		box-shadow: 0 40px 80px -40px rgba(124, 107, 255, 0.35);
	}
	.panel__bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #8d8ca3;
	}
	.panel__bar i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: #2a2a36;
	}
	.panel__bar span {
		margin-left: 0.5rem;
	}
	.panel__body {
		display: grid;
		grid-template-columns: 1fr;
	}
	.panel__side {
		display: none;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1rem 0.75rem;
		border-right: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.8rem;
		color: #8d8ca3;
	}
	.panel__side span {
		padding: 0.45rem 0.7rem;
		border-radius: 8px;
	}
	.panel__side .is-active {
		background: rgba(124, 107, 255, 0.18);
		color: #ffffff;
	}
	.panel__main {
		padding: 1.25rem;
	}
	.panel__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}
	.panel__title {
		font-weight: 600;
		color: #ffffff;
	}
	.panel__sub {
		margin-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: #8d8ca3;
	}
	.panel__badge {
		border-radius: 9999px;
		padding: 0.25rem 0.6rem;
		font-size: 0.7rem;
		font-weight: 600;
		background: rgba(58, 166, 110, 0.18);
		color: #6ee7a8;
	}
	@media (min-width: 768px) {
		.panel__body {
			grid-template-columns: 11rem 1fr;
		}
		.panel__side {
			display: flex;
		}
		.panel__main {
			padding: 1.5rem;
		}
	}
	.fields {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.fields li {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.25rem 1.25rem;
		padding: 0.8rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
	}
	.fields__name {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: #b7abff;
	}
	.fields__name b {
		font-family: var(--font-sans);
		font-weight: 450;
		color: #ffffff;
	}
	.fields__rule {
		font-size: 0.9rem;
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.7);
	}
	.fields__line {
		font-size: 0.8rem;
		font-weight: 450;
		color: #b7abff;
		white-space: nowrap;
	}
	.fields__foot {
		margin: 1rem 0 0;
		font-size: 0.85rem;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.5);
		text-align: left;
	}
	.panel__caption {
		margin: 1rem auto 0;
		max-width: 60rem;
		font-size: 0.8125rem;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.5);
	}
	@media (min-width: 720px) {
		.fields li {
			grid-template-columns: 15rem 1fr auto;
			align-items: baseline;
		}
		.fields__name {
			flex-direction: column;
			gap: 0.15rem;
		}
	}
</style>
