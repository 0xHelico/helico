---
const repo = 'https://github.com/0xHelico/helico'
// Permalinks to the vault as it is on main today, so the line numbers stay true when the file moves on.
const vault = `${repo}/blob/154bcabd85ca3be8f73851bbc55a1a04ea42c6e4/contracts/src/HelicoVault.sol`
const rules = [
	{
		field: 'poolId',
		rule: 'Only the pool you named. The position and the new range must both hash to it.',
		line: 489,
		error: 'PoolNotPermitted',
	},
	{
		field: 'rangeWidthTicks',
		rule: "Exactly the width you committed, on the pool's tick spacing. Nothing is snapped or rounded.",
		line: 733,
		error: 'RangeWidthMismatch',
	},
	{
		field: 'minImprovementBps',
		rule: 'The new range must sit closer to the price than the old one, by at least this much.',
		line: 747,
		error: 'NotEnoughImprovement',
	},
	{
		field: 'cooldownSeconds',
		rule: 'One move per cooldown, counted from the last one the vault executed.',
		line: 473,
		error: 'CooldownNotElapsed',
	},
	{
		field: 'maxLiquidity',
		rule: 'A cap on how much liquidity one move may touch, measured from the position rather than declared.',
		line: 486,
		error: 'LiquidityTooLarge',
	},
	{
		field: 'expiry',
		rule: 'After this timestamp the mandate is dead and every re-centre reverts.',
		line: 468,
		error: 'MandateExpired',
	},
	{
		field: 'minRetainedBps',
		rule: 'The share of your liquidity a move must keep, read back from the position it minted.',
		line: 718,
		error: 'LiquidityNotRetained',
	},
	{
		field: 'and the price',
		rule: 'The new range must contain the current tick. A band parked where no trade reaches it is refused.',
		line: 739,
		error: 'RangeOffMarket',
	},
]
const templates = [
	{
		label: 'Keep in range',
		name: 'Tight',
		copy: 'A narrow band around the price, moved often. Most fees, most re-centres.',
		chips: ['20 ticks', 'retain 90%', 'cooldown 1 h'],
	},
	{
		label: 'Wide and patient',
		name: 'Steady',
		copy: 'A wide band that only moves when the price has clearly left it.',
		chips: ['200 ticks', 'retain 95%', 'cooldown 24 h'],
	},
	{
		label: 'Hands off',
		name: 'Guarded',
		copy: 'Hold unless the improvement is worth the swap, and keep almost all of the position when it is.',
		chips: ['improve ≥ 50 bps', 'retain 95%', 'cooldown 12 h'],
	},
]
---

<section class="wrap enforcement" id="enforcement" aria-labelledby="enforcement-title">
	<div class="section-card section-card--dark center">
		<span class="eyebrow">How it works</span>
		<h2 class="headline" id="enforcement-title">Seven fields. <span class="grad">Every one</span> enforced on chain.</h2>
		<p class="lede">
			You sign a mandate once. The enclave decides inside it; the vault checks each field before
			anything moves, and a re-centre that fails any check reverts.
		</p>
		<div class="actions">
			<a class="btn btn--dark" href={`${repo}#readme`}>Get started</a>
			<a class="btn btn--ghost" href={`${vault}#L724`}>Read the check</a>
		</div>

		<div class="panel" aria-label="An example mandate">
			<div class="panel__bar"><i></i><i></i><i></i><span>helico · vault · Arbitrum One · not deployed yet</span></div>
			<div class="panel__body">
				<div class="panel__side">
					<span class="is-active">Mandate</span><span>Position</span><span>Enclave</span><span>Vault</span><span>Evidence</span>
				</div>
				<div class="panel__main">
					<div class="panel__head">
						<div>
							<div class="panel__title">Mandate · example position</div>
							<div class="panel__sub">ETH / ARB 0.05% · Uniswap v4 · hash 0x134be6bb…6225</div>
						</div>
						<span class="panel__badge">example</span>
					</div>
					<dl class="panel__grid">
						<div><dt>Pool</dt><dd>ETH / ARB 0.05%</dd></div>
						<div><dt>Range width</dt><dd>20 ticks</dd></div>
						<div><dt>Improvement</dt><dd>≥ 50 bps</dd></div>
						<div><dt>Cooldown</dt><dd>1 h</dd></div>
						<div><dt>Max liquidity</dt><dd>1e18</dd></div>
						<div><dt>Expires</dt><dd>in 30 d</dd></div>
						<div><dt>Retain</dt><dd>≥ 90%</dd></div>
					</dl>
				</div>
			</div>
		</div>
		<p class="panel__caption">
			Illustrative. Nothing is deployed yet. The fields are the seven the vault stores, and the hash is
			the test vector the enclave and the vault both reproduce.
		</p>

		<ol class="rules" style="text-align:left">
			{rules.map((r, i) => (
				<li class="card rule">
					<span class="rule__n">{String(i + 1).padStart(2, '0')}</span>
					<code class="rule__field">{r.field}</code>
					<p>{r.rule}</p>
					<a href={`${vault}#L${r.line}`}>{r.error} · line {r.line} ↗</a>
				</li>
			))}
		</ol>
		<p class="rules__foot">
			There is no other entry point. <code>recenter</code> and <code>recenterWithSignature</code> end in
			the same checks, and the swap between the burn and the mint is capped at the edge of the range you
			signed, so the pool itself halts it there.
		</p>

		<div class="split">
			<div>
				<h3>A mandate for every strategy.</h3>
				<p>From a tight band that moves often to a wide one that waits, the terms are yours; the enclave chooses inside them and the vault refuses the rest.</p>
			</div>
			<a class="btn btn--ghost" href={`${repo}/blob/main/contracts/README.md`}>Learn more</a>
		</div>
		<div class="cards" style="text-align:left">
			{templates.map((t) => (
				<div class="card">
					<span class="label">{t.label}</span>
					<h3 style="margin-top:.4rem">{t.name}</h3>
					<p>{t.copy}</p>
					<div class="chips">{t.chips.map((c) => <span class="chip"><i></i>{c}</span>)}</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.enforcement {
		margin-top: 2rem;
	}
	.panel {
		margin: clamp(2rem, 4vw, 3rem) auto 0;
		max-width: 60rem;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: #101017;
		text-align: left;
		box-shadow: 0 40px 80px -40px rgba(124, 107, 255, 0.35);
	}
	.panel__bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #8d8ca3;
	}
	.panel__bar i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: #2a2a36;
	}
	.panel__bar span {
		margin-left: 0.5rem;
	}
	.panel__body {
		display: grid;
		grid-template-columns: 1fr;
	}
	.panel__side {
		display: none;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1rem 0.75rem;
		border-right: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.8rem;
		color: #8d8ca3;
	}
	.panel__side span {
		padding: 0.45rem 0.7rem;
		border-radius: 8px;
	}
	.panel__side .is-active {
		background: rgba(124, 107, 255, 0.18);
		color: #ffffff;
	}
	.panel__main {
		padding: 1.25rem;
	}
	.panel__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}
	.panel__title {
		font-weight: 600;
		color: #ffffff;
	}
	.panel__sub {
		margin-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: #8d8ca3;
	}
	.panel__badge {
		border-radius: 9999px;
		padding: 0.25rem 0.6rem;
		font-size: 0.7rem;
		font-weight: 600;
		background: rgba(58, 166, 110, 0.18);
		color: #6ee7a8;
	}
	.panel__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
		gap: 0.6rem;
		margin: 1.1rem 0 0;
	}
	.panel__grid div {
		border-radius: 12px;
		padding: 0.7rem 0.8rem;
		background: #15151c;
		border: 1px solid rgba(255, 255, 255, 0.06);
	}
	.panel__grid dt {
		font-size: 0.7rem;
		color: #8d8ca3;
	}
	.panel__grid dd {
		margin: 0.2rem 0 0;
		font-weight: 600;
		color: #ffffff;
	}
	@media (min-width: 768px) {
		.panel__body {
			grid-template-columns: 11rem 1fr;
		}
		.panel__side {
			display: flex;
		}
		.panel__main {
			padding: 1.5rem;
		}
	}
	.panel__caption {
		margin: 0.9rem auto 0;
		max-width: 60rem;
		font-size: 0.75rem;
		color: #9a98ad;
	}
	.rules {
		display: grid;
		gap: 0.9rem;
		grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		padding: 0;
		list-style: none;
		counter-reset: rule;
	}
	.rule {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.rule__n {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: #b7abff;
	}
	.rule__field {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: #ffffff;
	}
	.rule p {
		flex: 1;
		margin: 0.2rem 0 0;
	}
	.rule a {
		margin-top: 0.6rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: #b7abff;
	}
	.rules__foot {
		max-width: 44rem;
		margin: 1.5rem auto 0;
		font-size: 0.9rem;
		line-height: 1.6;
		color: #b9b8c8;
	}
	.rules__foot code {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: #ffffff;
	}
</style>
