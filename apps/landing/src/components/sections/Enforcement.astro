---
import { forkTests } from '../../lib/solidity-tests'
const repo = 'https://github.com/0xHelico/helico'
// Permalinks pinned at the commit these line numbers were read from, so they stay true when the file moves on.
const vault = `${repo}/blob/154bcabd85ca3be8f73851bbc55a1a04ea42c6e4/contracts/src/HelicoVault.sol`
const fields = [
	{ label: 'Which market', field: 'poolId', value: 'ETH and ARB', note: 'nowhere else', line: 489 },
	{ label: 'How wide', field: 'rangeWidthTicks', value: 'narrow, 20 steps', note: 'never wider or narrower', line: 733 },
	{ label: 'Worth the move', field: 'minImprovementBps', value: 'at least 0.5% closer', note: 'or it stays put', line: 747 },
	{ label: 'How often', field: 'cooldownSeconds', value: 'once an hour at most', note: 'no churning', line: 473 },
	{ label: 'How much at once', field: 'maxLiquidity', value: 'a fixed cap', note: 'per move', line: 486 },
	{ label: 'Until when', field: 'expiry', value: '30 days', note: 'then nothing moves', line: 468 },
	{ label: 'How much to keep', field: 'minRetainedBps', value: 'at least 90%', note: 'checked after the move', line: 718 },
	{ label: 'Where the price is', field: '_checkRange', value: 'inside the band', note: 'or it earns nothing', line: 739 },
]
// The other tabs, illustrative like the mandate: the canvas's numbers for the position and the
// enclave, the vault's rules, and the fork rehearsal for the evidence.
const position = [
	['Market', 'ETH and ARB, on the Uniswap exchange, on the Arbitrum network'],
	['Band', 'a narrow band of prices, 20 steps wide'],
	['Price now', 'inside the band, so your funds are earning'],
	['Last move', 'kept 94.3% of the funds working, as in the rehearsal'],
	['Cooldown', 'until 15:32; no move can happen before then'],
	['Owner', 'you; the funds stay in your wallet and the contract may only move them'],
]
const enclave = [
	['Reads', 'the market\'s price and your funds, from inside a sealed environment'],
	['Checks', 'that the rules it was given are the rules the contract holds; if not, it stops'],
	['Decides', 'to wait while the price is inside the band or the cooldown runs; otherwise, a new band of your chosen width around the price'],
	['Sizes', 'the exchange that covers both sides of the new band, and what goes back in'],
	['Leaves', 'only the decision, signed with a key that never leaves the sealed environment'],
]
const vaultRows = [
	['Holds', 'a fingerprint of your rules, never the rules themselves'],
	['Checks', 'that the decision matches your rules, then every rule again: market, width, worth it, how often, cap, expiry, share kept, price inside'],
	['Moves', 'takes the funds out, exchanges only what the new band needs, puts them back in, all in one step'],
	['Ends', 'holding nothing; whatever the move did not use goes back to you'],
	['Refuses', 'anything else; there is no other way in'],
]
const evidence = [
	['Rehearsal', 'on a snapshot of the real market, an automated decision moved real funds that had drifted out of their band'],
	['Kept', '94.3% of the funds working; the rules demanded at least 50%'],
	['Second run', 'correctly did nothing, because the cooldown was running'],
	['Tests', `240+ automated tests, ${forkTests} of them on a snapshot of the real market`],
	['Caveats', 'a snapshot, not the live network; the sealed environment was simulated; nothing is deployed yet'],
]
const tabs = [
	{ id: 'mandate', label: 'Your rules' },
	{ id: 'position', label: 'Your funds' },
	{ id: 'enclave', label: 'The decider' },
	{ id: 'vault', label: 'The contract' },
	{ id: 'evidence', label: 'Evidence' },
]
const templates = [
	{ label: 'Earns the most', name: 'Active', copy: 'Stays close to the price and moves often.', chips: ['moves often', 'keeps 90%'] },
	{ label: 'Moves the least', name: 'Relaxed', copy: 'Moves only when the price has clearly drifted away.', chips: ['moves rarely', 'keeps 95%'] },
	{ label: 'Keeps the most', name: 'Cautious', copy: 'Moves only when it clearly pays, and keeps almost everything.', chips: ['only when it pays', 'keeps 95%'] },
]
---

<section class="wrap" id="enforcement" aria-labelledby="enforcement-title">
	<div class="section-card section-card--dark center">
		<span class="eyebrow">Your Rules</span>
		<h2 class="headline" id="enforcement-title">A Program That Cannot Break Your Rules</h2>
		<p class="lede">You set the rules. The program decides. The contract checks. Nothing moves otherwise.</p>
		<div class="actions">
			<a class="btn btn--dark" href={`${repo}#readme`}>Get Started</a>
			<a class="btn btn--ghost" href={`${vault}#L724`}>Learn More</a>
		</div>

		<div class="panel" aria-label="An example mandate and the rule the vault enforces for each field">
			<div class="panel__bar"><i></i><i></i><i></i><span>helico · vault · Arbitrum One · not deployed yet</span></div>
			<div class="panel__body">
				<div class="panel__side" role="tablist" aria-label="Panel sections" data-tabs>
					{tabs.map((t, i) => (
						<button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
					))}
				</div>
				<div class="panel__main" role="tabpanel" id="panel-mandate" aria-labelledby="tab-mandate">
					<div class="panel__head">
						<div>
							<div class="panel__title">Your rules · example</div>
							<div class="panel__sub">The seven rules for your funds, and what each one stops</div>
						</div>
						<span class="panel__badge">example</span>
					</div>
					<ol class="fields">
						{fields.map((f) => (
							<li>
								<span class="fields__name">{f.label}</span>
								<span class="fields__rule"><b>{f.value}</b> <span>{f.note}</span></span>
								<a class="fields__line" href={`${vault}#L${f.line}`} title={f.field}>line {f.line} ↗</a>
							</li>
						))}
					</ol>
					<p class="fields__foot">Break any of these and the contract rejects the move. There is no other way in.</p>
				</div>
				{[
					{ id: 'position', title: 'Your funds · example', sub: 'Your funds, as the contract and the program see them', rows: position },
					{ id: 'enclave', title: 'The decider · one run', sub: 'A sealed program that decides, every five minutes', rows: enclave },
					{ id: 'vault', title: 'The contract · every move', sub: 'It does not take the program\'s word for anything', rows: vaultRows },
					{ id: 'evidence', title: 'Evidence · what has run', sub: 'On a snapshot of the real market, 2026-09-06', rows: evidence },
				].map((t) => (
					<div class="panel__main" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden>
						<div class="panel__head">
							<div>
								<div class="panel__title">{t.title}</div>
								<div class="panel__sub">{t.sub}</div>
							</div>
							<span class="panel__badge">example</span>
						</div>
						<dl class="rows">
							{t.rows.map(([k, v]) => (
								<div><dt>{k}</dt><dd>{v}</dd></div>
							))}
						</dl>
					</div>
				))}
			</div>
		</div>
		<p class="panel__caption">An example, not a live account. Nothing is deployed yet; the seven rules are the ones the contract stores.</p>

		<div class="split">
			<div>
				<h3>Rules for every style.</h3>
				<p>Move often or rarely. Keep more or less. You pick once, and the contract stops everything else.</p>
			</div>
			<a class="btn btn--ghost" href={`${repo}/blob/main/contracts/README.md`}>Learn More</a>
		</div>
		<div class="cards" style="text-align:left">
			{templates.map((t) => (
				<div class="card">
					<span class="label">{t.label}</span>
					<h3>{t.name}</h3>
					<p>{t.copy}</p>
					<div class="chips">{t.chips.map((c) => <span class="chip"><i></i>{c}</span>)}</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	// Tabs: click or arrow keys move between them; only the selected panel is shown.
	for (const list of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
		const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
		const select = (tab: HTMLButtonElement) => {
			for (const t of tabs) {
				const on = t === tab
				t.setAttribute('aria-selected', String(on))
				t.tabIndex = on ? 0 : -1
				const panel = document.getElementById(t.getAttribute('aria-controls') ?? '')
				if (panel) panel.hidden = !on
			}
			tab.focus()
		}
		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(tab))
			tab.addEventListener('keydown', (e) => {
				const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0
				if (step === 0) return
				e.preventDefault()
				select(tabs[(i + step + tabs.length) % tabs.length] as HTMLButtonElement)
			})
		})
	}
</script>

<style>
	.enforcement {
		margin-top: 2rem;
	}
	.panel {
		margin: clamp(2rem, 4vw, 3rem) auto 0;
		max-width: 60rem;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: #101017;
		text-align: left;
		box-shadow: 0 40px 80px -40px rgba(124, 107, 255, 0.35);
	}
	.panel__bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #8d8ca3;
	}
	.panel__bar i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: #2a2a36;
	}
	.panel__bar span {
		margin-left: 0.5rem;
	}
	.panel__body {
		display: grid;
		grid-template-columns: 1fr;
	}
	/* On a phone the tabs are a strip that scrolls sideways; from tablet up, a sidebar. */
	.panel__side {
		display: flex;
		flex-direction: row;
		gap: 0.35rem;
		padding: 0.75rem;
		overflow-x: auto;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.8rem;
		color: #8d8ca3;
	}
	.panel__main {
		padding: 1.25rem;
	}
	.panel__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}
	.panel__title {
		font-weight: 600;
		color: #ffffff;
	}
	.panel__sub {
		margin-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: #8d8ca3;
	}
	.panel__badge {
		border-radius: 9999px;
		padding: 0.25rem 0.6rem;
		font-size: 0.7rem;
		font-weight: 600;
		background: rgba(58, 166, 110, 0.18);
		color: #6ee7a8;
	}
	@media (min-width: 768px) {
		.panel__body {
			grid-template-columns: 11rem 1fr;
		}
		.panel__side {
			flex-direction: column;
			gap: 0.2rem;
			padding: 1rem 0.75rem;
			overflow: visible;
			border-bottom: 0;
			border-right: 1px solid rgba(255, 255, 255, 0.08);
		}
		.panel__side button {
			width: 100%;
		}
		.panel__main {
			padding: 1.5rem;
		}
	}
	.fields {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.fields li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.15rem 1.25rem;
		padding: 0.7rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
	}
	.fields__name {
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.6);
	}
	.fields__rule {
		grid-column: 1 / -1;
		font-size: 0.95rem;
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.45);
	}
	.fields__rule b {
		font-weight: 500;
		color: #ffffff;
	}
	.fields__line {
		font-size: 0.8rem;
		font-weight: 450;
		color: #b7abff;
		white-space: nowrap;
	}
	.fields__foot {
		margin: 1rem 0 0;
		font-size: 0.85rem;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.5);
		text-align: left;
	}
	.panel__caption {
		margin: 1rem auto 0;
		max-width: 60rem;
		font-size: 0.8125rem;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.5);
	}
	@media (min-width: 720px) {
		.fields li {
			grid-template-columns: 10rem 1fr auto;
			align-items: baseline;
		}
		.fields__rule {
			grid-column: auto;
		}
	}
	@media (min-width: 1024px) {
		.fields li {
			grid-template-columns: 13rem 1fr auto;
		}
	}
	.panel__side button {
		display: block;
		flex: 0 0 auto;
		white-space: nowrap;
		padding: 0.55rem 0.75rem;
		border: 0;
		border-radius: 10px;
		background: none;
		text-align: left;
		font: inherit;
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.6);
		cursor: pointer;
	}
	.panel__side button:hover {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.05);
	}
	.panel__side button[aria-selected='true'] {
		color: #ffffff;
		background: rgba(124, 107, 255, 0.18);
	}
	.panel__side button:focus-visible {
		outline: 2px solid #b7abff;
		outline-offset: 2px;
	}
	.panel__main[hidden] {
		display: none;
	}
	.rows {
		margin: 1rem 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.rows div {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.2rem 1.25rem;
		padding: 0.8rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
	}
	.rows dt {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: #b7abff;
	}
	.rows dd {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.85);
	}
	@media (min-width: 720px) {
		.rows div {
			grid-template-columns: 9rem 1fr;
			align-items: baseline;
		}
	}
</style>
