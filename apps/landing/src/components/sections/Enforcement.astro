---
import { forkTests } from '../../lib/solidity-tests'
const repo = 'https://github.com/0xHelico/helico'
// Reading about Helico goes to the docs site; looking at the code goes to GitHub.
const docs = 'https://docs.helico.site/docs'
// Permalinks pinned at the commit these line numbers were read from, so they stay true when the
// files move on. Read from the code rather than remembered.
const at = (file: string) =>
	`${repo}/blob/cd1e76186f386ef15b00aee60aae940f9cf5ccf0/contracts/src/${file}`
const account = at('HelicoAccount.sol')
const proxy = at('HelicoAccountProxy.sol')
const swap = at('HelicoMandateSwap.sol')
// Deployed on Arbitrum One, 8 September 2026, and verified.
const deployed = 'https://arbiscan.io/address/0x01CC7d9FE8da79B61bcc5d3f7e3f0433DCE7E081'
const fields = [
	{ label: 'Who may move it', field: 'setAgent', value: 'the one you name', note: 'nobody else, ever', href: `${account}#L232` },
	{ label: 'Where it may go', field: 'permitVenue', value: 'markets you allow-list', note: 'and nowhere else', href: `${account}#L239` },
	{ label: 'Putting money to work', field: 'supplyIdle', value: 'into a permitted market', note: 'no recipient in the call', href: `${account}#L258` },
	{ label: 'Taking it back', field: 'withdrawIdle', value: 'even from one you revoked', note: 'so revoking never traps it', href: `${account}#L272` },
	{ label: 'Who the account admits', field: '_requireOwnerOrAgent', value: 'you, or the one you named', note: 'and no one else', href: `${account}#L292` },
	{ label: 'The way out', field: 'escape', value: 'everything, to you', note: 'no upgrade can remove it', href: `${proxy}#L71` },
	{ label: 'How much a swap may take', field: 'maxOut', value: 'a ceiling you set', note: 'per token, on the way out', href: `${swap}#L60` },
	{ label: 'Until when', field: 'expiry', value: 'a date you choose', note: 'then the mandate is dead', href: `${swap}#L68` },
]
// The other tabs, illustrative like the rules: the canvas's numbers for the account and the
// enclave, the account's own refusals, and the fork rehearsal for the evidence.
const position = [
	['Where it lives', 'a contract that is yours alone, at an address known before it exists'],
	['Liquid', 'enough to cover a swap against your mandate, held back on purpose'],
	['At work', 'the rest, earning in a lending market you allow-listed'],
	['Owner', 'you; the agent may move it between your own places and nowhere else'],
	['Ending it', 'remove the agent, or take everything out through a door no upgrade can close'],
]
const enclave = [
	['Reads', 'your account and every market you permitted, from inside a sealed environment'],
	['Checks', 'that the rules it was given are the rules you published; if not, it stops before touching the chain'],
	['Asks', 'the index what your live mandates could still be asked to pay, and holds that much back'],
	['Decides', 'the split, then whether the difference is worth its own gas'],
	['Leaves', 'only the decision, signed with a key that never leaves the sealed environment'],
]
const accountRows = [
	['Admits', 'you, or the agent you named — and checks it on every call'],
	['Refuses', 'any market you did not allow-list, and any caller you did not name'],
	['Cannot', 'transfer, approve, add a market, or upgrade itself'],
	['Has no recipient', 'both calls the agent can make end at this account; there is no address to redirect'],
	['Cannot be walled up', 'the way out lives in the proxy, so replacing the code cannot remove it'],
]
const evidence = [
	['Deployed', 'the account factory, the Aqua app and the SwapVM router are live on Arbitrum One and verified'],
	['Rehearsal', 'on a snapshot of the real market, the sealed program moved 40,000 of 50,000 USDC into real Aave v3'],
	['Left behind', '10,000 held liquid, and the agent\'s own balance zero — a move that goes nowhere reads like one that worked'],
	['Through the app', 'opening an account, naming the agent and permitting a market, all checked against the chain rather than the screen'],
	['Tests', `240+ automated tests, ${forkTests} of them on a snapshot of the real market, and 32 browser checks`],
	['Caveats', 'the rehearsal is a snapshot, not the live network, and the sealed environment was simulated'],
]
const tabs = [
	{ id: 'mandate', label: 'Your rules' },
	{ id: 'position', label: 'Your funds' },
	{ id: 'enclave', label: 'The decider' },
	{ id: 'contract', label: 'The contract' },
	{ id: 'evidence', label: 'Evidence' },
]
const templates = [
	{ label: 'Earns the most', name: 'Active', copy: 'Keeps only what a swap needs on hand, and puts the rest to work.', chips: ['90% at work', 'moves on small gaps'] },
	{ label: 'Moves the least', name: 'Relaxed', copy: 'Moves only when the difference is clearly worth its own gas.', chips: ['70% at work', 'moves rarely'] },
	{ label: 'Keeps the most', name: 'Cautious', copy: 'Holds a wide buffer, so a swap never waits on a lending market.', chips: ['50% at work', 'wide buffer'] },
]
---

<section class="wrap" id="enforcement" aria-labelledby="enforcement-title">
	<div class="section-card section-card--dark center" data-reveal>
		<span class="eyebrow">Your Rules</span>
		<h2 class="headline" id="enforcement-title">A Program That Cannot Break Your Rules</h2>
		<p class="lede">You set the rules. The program decides. The contract checks. Nothing moves otherwise.</p>
		<div class="actions">
			<a class="btn btn--dark" href={`${docs}/introduction`}>Get Started</a>
			<a class="btn btn--ghost" href={deployed}>See the Contract</a>
		</div>

		<div class="panel" aria-label="An example mandate and the rule the account enforces for each field">
			<div class="panel__bar"><i></i><i></i><i></i><span>helico · account · Arbitrum One · deployed</span></div>
			<div class="panel__body">
				<div class="panel__side" role="tablist" aria-label="Panel sections" data-tabs>
					{tabs.map((t, i) => (
						<button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
					))}
				</div>
				<div class="panel__main" role="tabpanel" id="panel-mandate" aria-labelledby="tab-mandate">
					<div class="panel__head">
						<div>
							<div class="panel__title">Your rules · example</div>
							<div class="panel__sub">The rules for your funds, and what each one stops</div>
						</div>
						<span class="panel__badge">example</span>
					</div>
					<ol class="fields">
						{fields.map((f) => (
							<li>
								<span class="fields__name">{f.label}</span>
								<span class="fields__rule"><b>{f.value}</b> <span>{f.note}</span></span>
								<a class="fields__line" href={f.href} title={f.field}>{f.field} ↗</a>
							</li>
						))}
					</ol>
					<p class="fields__foot">Break any of these and the contract rejects the move. There is no other way in.</p>
				</div>
				{[
					{ id: 'position', title: 'Your funds · example', sub: 'Your funds, as the contract and the program see them', rows: position },
					{ id: 'enclave', title: 'The decider · one run', sub: 'A sealed program that decides, every five minutes', rows: enclave },
					{ id: 'contract', title: 'The contract · every move', sub: 'It does not take the program\'s word for anything', rows: accountRows },
					{ id: 'evidence', title: 'Evidence · what has run', sub: 'Deployed on Arbitrum One, and rehearsed on a snapshot of it', rows: evidence },
				].map((t) => (
					<div class="panel__main" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden>
						<div class="panel__head">
							<div>
								<div class="panel__title">{t.title}</div>
								<div class="panel__sub">{t.sub}</div>
							</div>
							<span class="panel__badge">example</span>
						</div>
						<dl class="rows">
							{t.rows.map(([k, v]) => (
								<div><dt>{k}</dt><dd>{v}</dd></div>
							))}
						</dl>
					</div>
				))}
			</div>
		</div>
		<p class="panel__caption">An example account, not a live one — but the contracts are deployed on Arbitrum One, and every rule above links to the line that enforces it.</p>

		<div class="split">
			<div>
				<h3>Rules for every style.</h3>
				<p>Keep more on hand or put more to work. Move on small differences or only on large ones. You pick once, and the contract stops everything else.</p>
			</div>
			<a class="btn btn--ghost" href={`${docs}/your-rules`}>About the Rules</a>
		</div>
		<div class="cards" style="text-align:left">
			{templates.map((t) => (
				<div class="card">
					<span class="label">{t.label}</span>
					<h3>{t.name}</h3>
					<p>{t.copy}</p>
					<div class="chips">{t.chips.map((c) => <span class="chip"><i></i>{c}</span>)}</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	// Tabs: click or arrow keys move between them; only the selected panel is shown.
	for (const list of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
		const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
		const select = (tab: HTMLButtonElement) => {
			for (const t of tabs) {
				const on = t === tab
				t.setAttribute('aria-selected', String(on))
				t.tabIndex = on ? 0 : -1
				const panel = document.getElementById(t.getAttribute('aria-controls') ?? '')
				if (panel) panel.hidden = !on
			}
			tab.focus()
		}
		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(tab))
			tab.addEventListener('keydown', (e) => {
				const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0
				if (step === 0) return
				e.preventDefault()
				select(tabs[(i + step + tabs.length) % tabs.length] as HTMLButtonElement)
			})
		})
	}
</script>

<style>
	.enforcement {
		margin-top: 2rem;
	}
	.panel {
		margin: clamp(2rem, 4vw, 3rem) auto 0;
		max-width: 60rem;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: #101017;
		text-align: left;
		box-shadow: 0 40px 80px -40px rgba(124, 107, 255, 0.35);
	}
	.panel__bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #8d8ca3;
	}
	.panel__bar i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: #2a2a36;
	}
	.panel__bar span {
		margin-left: 0.5rem;
	}
	.panel__body {
		display: grid;
		grid-template-columns: 1fr;
	}
	/* On a phone the tabs are a strip that scrolls sideways; from tablet up, a sidebar. */
	.panel__side {
		display: flex;
		flex-direction: row;
		gap: 0.35rem;
		padding: 0.75rem;
		overflow-x: auto;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.8rem;
		color: #8d8ca3;
	}
	.panel__main {
		padding: 1.25rem;
	}
	.panel__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}
	.panel__title {
		font-weight: 600;
		color: #ffffff;
	}
	.panel__sub {
		margin-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: #8d8ca3;
	}
	.panel__badge {
		border-radius: 9999px;
		padding: 0.25rem 0.6rem;
		font-size: 0.7rem;
		font-weight: 600;
		background: rgba(58, 166, 110, 0.18);
		color: #6ee7a8;
	}
	@media (min-width: 768px) {
		.panel__body {
			grid-template-columns: 11rem 1fr;
		}
		.panel__side {
			flex-direction: column;
			gap: 0.2rem;
			padding: 1rem 0.75rem;
			overflow: visible;
			border-bottom: 0;
			border-right: 1px solid rgba(255, 255, 255, 0.08);
		}
		.panel__side button {
			width: 100%;
		}
		.panel__main {
			padding: 1.5rem;
		}
	}
	.fields {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.fields li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.15rem 1.25rem;
		padding: 0.7rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
	}
	.fields__name {
		font-size: 0.9rem;
		color: rgba(255, 255, 255, 0.6);
	}
	.fields__rule {
		grid-column: 1 / -1;
		font-size: 0.95rem;
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.45);
	}
	.fields__rule b {
		font-weight: 500;
		color: #ffffff;
	}
	.fields__line {
		font-size: 0.8rem;
		font-weight: 450;
		color: #b7abff;
		white-space: nowrap;
	}
	.fields__foot {
		margin: 1rem 0 0;
		font-size: 0.85rem;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.5);
		text-align: left;
	}
	.panel__caption {
		margin: 1rem auto 0;
		max-width: 60rem;
		font-size: 0.8125rem;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.5);
	}
	@media (min-width: 720px) {
		.fields li {
			grid-template-columns: 10rem 1fr auto;
			align-items: baseline;
		}
		.fields__rule {
			grid-column: auto;
		}
	}
	@media (min-width: 1024px) {
		.fields li {
			grid-template-columns: 13rem 1fr auto;
		}
	}
	.panel__side button {
		display: block;
		flex: 0 0 auto;
		white-space: nowrap;
		padding: 0.55rem 0.75rem;
		border: 0;
		border-radius: 10px;
		background: none;
		text-align: left;
		font: inherit;
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.6);
		cursor: pointer;
	}
	.panel__side button:hover {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.05);
	}
	.panel__side button[aria-selected='true'] {
		color: #ffffff;
		background: rgba(124, 107, 255, 0.18);
	}
	.panel__side button:focus-visible {
		outline: 2px solid #b7abff;
		outline-offset: 2px;
	}
	.panel__main[hidden] {
		display: none;
	}
	.rows {
		margin: 1rem 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.rows div {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.2rem 1.25rem;
		padding: 0.8rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
	}
	.rows dt {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: #b7abff;
	}
	.rows dd {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.85);
	}
	@media (min-width: 720px) {
		.rows div {
			grid-template-columns: 9rem 1fr;
			align-items: baseline;
		}
	}
</style>
