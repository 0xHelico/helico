---
const repo = 'https://github.com/0xHelico/helico'
// Permalinks pinned at the commit these line numbers were read from, so they stay true when the file moves on.
const vault = `${repo}/blob/154bcabd85ca3be8f73851bbc55a1a04ea42c6e4/contracts/src/HelicoVault.sol`
const fields = [
	{ field: 'poolId', value: 'ETH / ARB 0.05%', rule: 'Only the pool you named. Nothing can move your money somewhere else.', line: 489 },
	{ field: 'rangeWidthTicks', value: '20 ticks', rule: 'The new range is exactly as wide as you said, never wider or narrower.', line: 733 },
	{ field: 'minImprovementBps', value: '≥ 50 bps', rule: 'A move has to be worth it: the new spot must be this much closer to the price.', line: 747 },
	{ field: 'cooldownSeconds', value: '1 h', rule: 'At most one move per hour, so nothing can churn your deposit.', line: 473 },
	{ field: 'maxLiquidity', value: '1e18', rule: 'A ceiling on how much one move may touch.', line: 486 },
	{ field: 'expiry', value: 'in 30 d', rule: 'After this date the rules expire and nothing can move.', line: 468 },
	{ field: 'minRetainedBps', value: '≥ 90%', rule: 'A move must keep at least this share of your deposit working, measured after the fact.', line: 718 },
	{ field: 'the price', value: 'tick inside', rule: 'The new range must contain the current price, or it would earn nothing.', line: 739 },
]
// The other tabs, illustrative like the mandate: the canvas's numbers for the position and the
// enclave, the vault's rules, and the fork rehearsal for the evidence.
const position = [
	['Pool', 'ETH and ARB, on the Uniswap exchange, on the Arbitrum network'],
	['Range', 'a narrow band of prices, 20 steps wide'],
	['Price now', 'inside the range, so the deposit is earning'],
	['Last move', 'kept 98% of the deposit working'],
	['Cooldown', 'until 15:32; no move can happen before then'],
	['Owner', 'you; the deposit stays in your wallet and the contract may only move it'],
]
const enclave = [
	['Reads', 'the pool\'s price and your deposit, from inside a sealed environment'],
	['Checks', 'that the rules it was given are the rules the contract holds; if not, it stops'],
	['Decides', 'to wait while the price is inside the range or the cooldown runs; otherwise, a new range of your chosen width around the price'],
	['Sizes', 'the exchange that funds both sides of the new range, and the new deposit'],
	['Leaves', 'only the decision, signed with a key that never leaves the sealed environment'],
]
const vaultRows = [
	['Holds', 'a fingerprint of your rules, never the rules themselves'],
	['Checks', 'that the decision matches your rules, then every rule again: pool, width, worth it, cooldown, ceiling, expiry, share kept, price inside'],
	['Moves', 'takes the deposit out, exchanges only what the new range needs, puts a new deposit in, all in one step'],
	['Ends', 'holding nothing; whatever the move did not use goes back to you'],
	['Refuses', 'anything else; there is no other way in'],
]
const evidence = [
	['Rehearsal', 'on a snapshot of the real market, an automated decision moved a real deposit that had drifted out of range'],
	['Kept', '94.3% of the deposit working; the rules demanded at least 50%'],
	['Second run', 'correctly did nothing, because the cooldown was running'],
	['Tests', '240+ automated tests, 9 of them on a snapshot of the real market'],
	['Caveats', 'a snapshot, not the live network; the sealed environment was simulated; nothing is deployed yet'],
]
const tabs = [
	{ id: 'mandate', label: 'Mandate' },
	{ id: 'position', label: 'Position' },
	{ id: 'enclave', label: 'Enclave' },
	{ id: 'vault', label: 'Vault' },
	{ id: 'evidence', label: 'Evidence' },
]
const templates = [
	{
		label: 'Keep in range',
		name: 'Tight',
		copy: 'A narrow range around the price, moved often. Earns the most, moves the most.',
		chips: ['20 ticks', 'retain 90%', 'cooldown 1 h'],
	},
	{
		label: 'Wide and patient',
		name: 'Steady',
		copy: 'A wide range that only moves when the price has clearly left it.',
		chips: ['200 ticks', 'retain 95%', 'cooldown 24 h'],
	},
	{
		label: 'Hands off',
		name: 'Guarded',
		copy: 'Stay put unless a move is clearly worth it, and keep almost all of the deposit when it is.',
		chips: ['improve ≥ 50 bps', 'retain 95%', 'cooldown 12 h'],
	},
]
---

<section class="wrap" id="enforcement" aria-labelledby="enforcement-title">
	<div class="section-card section-card--dark center">
		<span class="eyebrow">Helico Mandate</span>
		<h2 class="headline" id="enforcement-title">A Program That Cannot Break Your Rules</h2>
		<p class="lede">You set the rules. The program decides. The contract checks. Nothing moves otherwise.</p>
		<div class="actions">
			<a class="btn btn--dark" href={`${repo}#readme`}>Get Started</a>
			<a class="btn btn--ghost" href={`${vault}#L724`}>Learn More</a>
		</div>

		<div class="panel" aria-label="An example mandate and the rule the vault enforces for each field">
			<div class="panel__bar"><i></i><i></i><i></i><span>helico · vault · Arbitrum One · not deployed yet</span></div>
			<div class="panel__body">
				<div class="panel__side" role="tablist" aria-label="Panel sections" data-tabs>
					{tabs.map((t, i) => (
						<button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
					))}
				</div>
				<div class="panel__main" role="tabpanel" id="panel-mandate" aria-labelledby="tab-mandate">
					<div class="panel__head">
						<div>
							<div class="panel__title">Mandate · example position</div>
							<div class="panel__sub">The seven rules for one deposit, and what each one stops</div>
						</div>
						<span class="panel__badge">example</span>
					</div>
					<ol class="fields">
						{fields.map((f) => (
							<li>
								<span class="fields__name"><code>{f.field}</code><b>{f.value}</b></span>
								<span class="fields__rule">{f.rule}</span>
								<a class="fields__line" href={`${vault}#L${f.line}`}>line {f.line} ↗</a>
							</li>
						))}
					</ol>
					<p class="fields__foot">Seven rules, plus one for the price. A move that breaks any of them is rejected by the contract itself; there is no other way in.</p>
				</div>
				{[
					{ id: 'position', title: 'Position · example', sub: 'One deposit, as the contract and the program see it', rows: position },
					{ id: 'enclave', title: 'Enclave · one run', sub: 'The sealed program that decides, every five minutes', rows: enclave },
					{ id: 'vault', title: 'Vault · every move', sub: 'The contract that does not take the program\'s word for it', rows: vaultRows },
					{ id: 'evidence', title: 'Evidence · what has run', sub: 'On a snapshot of the real market, 2026-09-06', rows: evidence },
				].map((t) => (
					<div class="panel__main" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden>
						<div class="panel__head">
							<div>
								<div class="panel__title">{t.title}</div>
								<div class="panel__sub">{t.sub}</div>
							</div>
							<span class="panel__badge">example</span>
						</div>
						<dl class="rows">
							{t.rows.map(([k, v]) => (
								<div><dt>{k}</dt><dd>{v}</dd></div>
							))}
						</dl>
					</div>
				))}
			</div>
		</div>
		<p class="panel__caption">An example, not a live account. Nothing is deployed yet; the seven rules are the ones the contract stores.</p>

		<div class="split">
			<div>
				<h3>Rules for every style.</h3>
				<p>Move often or rarely, keep more or less: you choose. The program works inside your rules, and the contract stops everything else.</p>
			</div>
			<a class="btn btn--ghost" href={`${repo}/blob/main/contracts/README.md`}>Learn More</a>
		</div>
		<div class="cards" style="text-align:left">
			{templates.map((t) => (
				<div class="card">
					<span class="label">{t.label}</span>
					<h3>{t.name}</h3>
					<p>{t.copy}</p>
					<div class="chips">{t.chips.map((c) => <span class="chip"><i></i>{c}</span>)}</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	// Tabs: click or arrow keys move between them; only the selected panel is shown.
	for (const list of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
		const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
		const select = (tab: HTMLButtonElement) => {
			for (const t of tabs) {
				const on = t === tab
				t.setAttribute('aria-selected', String(on))
				t.tabIndex = on ? 0 : -1
				const panel = document.getElementById(t.getAttribute('aria-controls') ?? '')
				if (panel) panel.hidden = !on
			}
			tab.focus()
		}
		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(tab))
			tab.addEventListener('keydown', (e) => {
				const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0
				if (step === 0) return
				e.preventDefault()
				select(tabs[(i + step + tabs.length) % tabs.length] as HTMLButtonElement)
			})
		})
	}
</script>

<style>
	.enforcement {
		margin-top: 2rem;
	}
	.panel {
		margin: clamp(2rem, 4vw, 3rem) auto 0;
		max-width: 60rem;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: #101017;
		text-align: left;
		box-shadow: 0 40px 80px -40px rgba(124, 107, 255, 0.35);
	}
	.panel__bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #8d8ca3;
	}
	.panel__bar i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: #2a2a36;
	}
	.panel__bar span {
		margin-left: 0.5rem;
	}
	.panel__body {
		display: grid;
		grid-template-columns: 1fr;
	}
	.panel__side {
		display: none;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1rem 0.75rem;
		border-right: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.8rem;
		color: #8d8ca3;
	}
	.panel__main {
		padding: 1.25rem;
	}
	.panel__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}
	.panel__title {
		font-weight: 600;
		color: #ffffff;
	}
	.panel__sub {
		margin-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: #8d8ca3;
	}
	.panel__badge {
		border-radius: 9999px;
		padding: 0.25rem 0.6rem;
		font-size: 0.7rem;
		font-weight: 600;
		background: rgba(58, 166, 110, 0.18);
		color: #6ee7a8;
	}
	@media (min-width: 768px) {
		.panel__body {
			grid-template-columns: 11rem 1fr;
		}
		.panel__side {
			display: flex;
		}
		.panel__main {
			padding: 1.5rem;
		}
	}
	.fields {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}
	.fields li {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.25rem 1.25rem;
		padding: 0.8rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
	}
	.fields__name {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: #b7abff;
	}
	.fields__name b {
		font-family: var(--font-sans);
		font-weight: 450;
		color: #ffffff;
	}
	.fields__rule {
		font-size: 0.9rem;
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.7);
	}
	.fields__line {
		font-size: 0.8rem;
		font-weight: 450;
		color: #b7abff;
		white-space: nowrap;
	}
	.fields__foot {
		margin: 1rem 0 0;
		font-size: 0.85rem;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.5);
		text-align: left;
	}
	.panel__caption {
		margin: 1rem auto 0;
		max-width: 60rem;
		font-size: 0.8125rem;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.5);
	}
	@media (min-width: 720px) {
		.fields li {
			grid-template-columns: 15rem 1fr auto;
			align-items: baseline;
		}
		.fields__name {
			flex-direction: column;
			gap: 0.15rem;
		}
	}
	.panel__side button {
		display: block;
		width: 100%;
		padding: 0.55rem 0.75rem;
		border: 0;
		border-radius: 10px;
		background: none;
		text-align: left;
		font: inherit;
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.6);
		cursor: pointer;
	}
	.panel__side button:hover {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.05);
	}
	.panel__side button[aria-selected='true'] {
		color: #ffffff;
		background: rgba(124, 107, 255, 0.18);
	}
	.panel__side button:focus-visible {
		outline: 2px solid #b7abff;
		outline-offset: 2px;
	}
