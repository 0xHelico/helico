---
import { readFileSync } from 'node:fs'
import { Code } from 'astro:components'
import { creTests, solidityTests } from '../../lib/solidity-tests'
const repo = 'https://github.com/0xHelico/helico'
// Reading about Helico goes to the docs site; looking at the code goes to GitHub.
const docs = 'https://docs.helico.site/docs'
// Read from the Aqua app's source at build time, so the page shows the function as this
// checkout has it. `_requireReceiptFor` is the one worth showing: a receipt token is an address
// the maker writes into their own mandate, so anything it says about itself is something they
// could have made up. Asking the pool which receipt it issues is the only direction that cannot
// be faked, and four lines is the whole of it.
const source = readFileSync(new URL('../../../../../contracts/src/HelicoMandateSwap.sol', import.meta.url), 'utf8')
const from = source.indexOf('    function _requireReceiptFor(')
const to = source.indexOf('\n    }\n', from) + '\n    }'.length
const check = source.slice(from, to).replace(/^ {4}/gm, '')
// The real line number of the first line in this checkout, for the gutter. The link below
// goes to the file on main without an anchor: a number computed from one revision must not
// be pinned to another (#74).
const startLine = source.slice(0, from).split('\n').length
const packages = [
	{
		name: 'HelicoMandateSwap',
		stat: String(solidityTests),
		unit: 'tests',
		copy: 'An Aqua app of our own, live on Arbitrum One. The mandate is the strategy, and every refusal has a name.',
		href: `${repo}/tree/main/contracts`,
	},
	{
		name: '@helico/plugin-thegraph',
		stat: '28',
		unit: 'tests',
		copy: 'Asks the index what Aqua cannot be asked: which mandates a wallet holds, and what is left in each.',
		href: `${repo}/tree/main/packages/plugins/thegraph`,
	},
	{
		name: '@helico/plugin-cre',
		stat: String(creTests),
		unit: 'tests',
		copy: 'Decides and sizes inside the enclave. Chainlink\'s network writes the move.',
		href: `${repo}/tree/main/packages/plugins/cre`,
	},
]
---

<section class="wrap" id="build" aria-labelledby="build-title">
	<div class="section-card center" data-reveal>
		<span class="eyebrow">For builders</span>
		<h2 class="headline" id="build-title">Built in the Open</h2>
		<p class="lede">Every line is public: the Aqua app, the program that decides, and the tests for both.</p>
		<div class="actions">
			<a class="btn btn--primary" href={repo}>See the Code</a>
			<a class="btn btn--secondary" href={`${repo}/tree/main/docs/plans`}>Read the Plans</a>
		</div>

		<figure class="code" style={`--start:${startLine - 1}`}>
			<figcaption>For builders · contracts/src/HelicoMandateSwap.sol · <code>_requireReceiptFor</code> · <a href={`${repo}/blob/main/contracts/src/HelicoMandateSwap.sol`}>open on GitHub ↗</a></figcaption>
			<Code code={check} lang="solidity" theme="dark-plus" />
		</figure>

		<div class="split">
			<div>
				<h3>Open by default.</h3>
				<p>The code above is the actual check our Aqua app runs, read from the source when this page is built. Every count below points at the code that proves it.</p>
			</div>
			<a class="btn btn--secondary" href={`${docs}/builders`}>Docs for Builders</a>
		</div>
		<div class="cards" style="text-align:left">
			{packages.map((p) => (
				<div class="card">
					<span class="label">{p.name}</span>
					<span class="stat">{p.stat} <small>{p.unit}</small></span>
					<p>{p.copy}</p>
					<a class="link" href={p.href} aria-label={`Read the source of ${p.name}`}>Read the source ↗</a>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.code {
		margin: clamp(2.5rem, 5vw, 4rem) auto 0;
		max-width: 60rem;
		text-align: left;
		border-radius: 24px;
		overflow: hidden;
		background: #1e1e1e;
		color: #d4d4d4;
		box-shadow: 0 40px 80px -40px rgba(93, 76, 230, 0.35);
	}
	.code figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0.8rem 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.5);
		background: #252526;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.code figcaption code,
	.code figcaption a {
		color: #b7abff;
	}
	/* Shiki's output is global markup, so the gutter and sizing are addressed as such. VS Code's
	   Dark+ theme and its editor background; the line numbers are the file's real ones. */
	.code :global(pre.astro-code) {
		margin: 0;
		padding: 1.1rem 0;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.6;
		tab-size: 4;
		font-variant-ligatures: none;
		counter-reset: line var(--start);
	}
	.code :global(.astro-code .line) {
		display: inline-block;
		min-width: 100%;
		padding-right: 1.5rem;
	}
	.code :global(.astro-code .line)::before {
		counter-increment: line;
		content: counter(line);
		display: inline-block;
		width: 3.75rem;
		padding-right: 1.25rem;
		text-align: right;
		color: #858585;
		user-select: none;
	}
</style>
