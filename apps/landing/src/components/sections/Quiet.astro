---
const repo = 'https://github.com/0xHelico/helico'
// Permalinks to the vault as it is on main today, so the line numbers stay true when the file moves on.
const vault = `${repo}/blob/154bcabd85ca3be8f73851bbc55a1a04ea42c6e4/contracts/src/HelicoVault.sol`
const holds = [
	{
		verdict: 'Hold',
		reason: 'Cooldown',
		copy: 'The last move was too recent. The enclave does not size anything, and the vault would refuse the move if it did.',
		href: `${vault}#L473`,
	},
	{
		verdict: 'Hold',
		reason: 'Not worth it',
		copy: 'The best new range does not close the gap by the minimum improvement. No swap, no gas, no report.',
		href: `${vault}#L747`,
	},
	{
		verdict: 'Refuse',
		reason: 'Mandate changed',
		copy: 'The authorisation names a mandate hash the vault no longer holds. The vault rejects it before it reads anything else.',
		href: `${vault}#L415`,
	},
]
---

<section class="wrap quiet" id="quiet" aria-labelledby="quiet-title">
	<div class="section-card center">
		<span class="eyebrow">Restraint</span>
		<h2 class="headline" id="quiet-title">Most of the time, it does nothing.</h2>
		<p class="lede">
			A re-centre costs gas and a swap. The enclave holds unless the mandate says a move is worth it,
			and the vault refuses anything the mandate does not cover.
		</p>
		<div class="actions">
			<a class="btn btn--secondary" href="#canvas">See a hold and a refusal</a>
		</div>
		<div class="cards" style="text-align:left">
			{holds.map((h) => (
				<div class="card">
					<span class="label">{h.verdict}</span>
					<h3 style="margin-top:.4rem">{h.reason}</h3>
					<p>{h.copy}</p>
					<a class="card__link" href={h.href}>the line in the vault ↗</a>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.quiet {
		margin-top: 2rem;
	}
	.card__link {
		display: inline-block;
		margin-top: 0.75rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: #5d4ce6;
	}
</style>
