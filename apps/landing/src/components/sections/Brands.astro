---
import { Image } from 'astro:assets'
// Protocols, chains, and tools this was built with. Not backers: Helico has none, and the
// hackathon's prize sponsors are not that. Drop a logo at src/assets/brands/<slug>.svg
// (png and webp work too) and it replaces the wordmark.
const brands = [
	{ slug: 'uniswap', name: 'Uniswap v4' },
	{ slug: 'chainlink', name: 'Chainlink CRE' },
	{ slug: 'arbitrum', name: 'Arbitrum One' },
	{ slug: 'robinhood', name: 'Robinhood Chain' },
	{ slug: 'base', name: 'Base' },
	{ slug: 'ethereum', name: 'Ethereum' },
	{ slug: 'free-pi', name: 'FREE-PI' },
	{ slug: 'one-dollar-audit', name: 'One Dollar Audit' },
]
// Eleven show; when there are more, a twelfth cell opens the rest, the way the reference does it.
const SHOWN = 11
const files = import.meta.glob<ImageMetadata>('../../assets/brands/*.{svg,png,webp}', {
	eager: true,
	import: 'default',
})
const logoFor = (slug: string) => {
	const key = Object.keys(files).find((k) => /\/([^/]+)\.(svg|png|webp)$/.exec(k)?.[1] === slug)
	return key ? files[key] : null
}
const items = brands.map((b) => ({ ...b, logo: logoFor(b.slug) }))
---

<section class="wrap" aria-labelledby="brands-title">
	<div class="section-card section-card--white brands" data-reveal>
		<h2 id="brands-title">Built with</h2>
		<ul class="brands__grid" data-brands>
			{items.map((b, i) => (
				<li class:list={{ 'is-more': i >= SHOWN }} hidden={i >= SHOWN}>
					{b.logo ? <Image src={b.logo} alt={b.name} height={28} densities={[1, 2]} /> : <span>{b.name}</span>}
				</li>
			))}
			{items.length > SHOWN && (
				<li class="brands__toggle">
					<button type="button" data-brands-more aria-expanded="false">View More</button>
				</li>
			)}
		</ul>
	</div>
</section>

<script>
	const grid = document.querySelector<HTMLElement>('[data-brands]')
	const more = document.querySelector<HTMLButtonElement>('[data-brands-more]')
	more?.addEventListener('click', () => {
		for (const li of grid?.querySelectorAll<HTMLElement>('.is-more') ?? []) li.hidden = false
		more.setAttribute('aria-expanded', 'true')
		more.closest('li')?.remove()
	})
</script>

<style>
	.brands {
		padding: 3rem 1.5rem;
	}
	.brands h2 {
		margin: 0 0 2rem;
		text-align: center;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.03em;
		color: var(--ink-90);
	}
	.brands__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1px;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 1px 0;
		list-style: none;
		background: rgba(37, 34, 40, 0.08);
	}
	.brands__grid li {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 120px;
		padding: 1rem;
		background: #ffffff;
	}
	.brands__grid li[hidden] {
		display: none;
	}
	.brands__grid img {
		height: 28px;
		width: auto;
		filter: grayscale(1);
		opacity: 0.7;
		transition:
			opacity 0.2s,
			filter 0.2s;
	}
	.brands__grid li:hover img {
		filter: none;
		opacity: 1;
	}
	.brands__grid span {
		font-size: 1.125rem;
		font-weight: 550;
		letter-spacing: -0.02em;
		text-align: center;
		color: var(--ink-65);
	}
	.brands__toggle button {
		border: 0;
		background: none;
		padding: 0.5rem 0.75rem;
		border-radius: 99px;
		font-size: 1.0625rem;
		font-weight: 450;
		letter-spacing: -0.01em;
		color: var(--ink-65);
	}
	.brands__toggle button:hover {
		color: var(--ink-90);
		background: rgba(37, 34, 40, 0.04);
	}
	@media (min-width: 720px) {
		.brands__grid {
			grid-template-columns: repeat(4, 1fr);
		}
		.brands__grid li {
			min-height: 150px;
		}
	}
</style>
