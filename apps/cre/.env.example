###############################################################################
### Copy to `.env` (gitignored) and fill in. DO NOT COMMIT OR SHARE `.env`.  ###
###############################################################################

# The key the CRE CLI broadcasts with when simulating with --broadcast. In a
# deployed Confidential Workflow the DON signs instead, and this is unused.
# For `rehearse.sh` this is anvil's first account, which is public knowledge
# and holds nothing on any real chain.
CRE_ETH_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CRE_TARGET=staging-settings

# --- the private half of the policy ---------------------------------------
# Read only inside the enclave. Amounts are in the asset's own units, and the
# asset is USDC on Arbitrum, so six decimals: 100000000 is 100 USDC. Getting
# that wrong is a thousand-fold error and there is nothing on chain to catch
# it — `HelicoAccount` enforces where the money may go, never how much.
#
# The values below say: keep 80% of the account earning at Aave, never leave
# less than 100 USDC liquid to cover a swap against an Aqua mandate, and do
# not move at all for less than 25 USDC or less than 0.5% of the account.
# The two floors are the deadband, and they are what stops the workflow paying
# gas every five minutes to chase the interest that accrued since the last run.
#
# `IDLE_MIN_SUPPLY_RATE_RAY` is a ray, so 1e27 is 100%; zero turns the floor
# off. `IDLE_MAX_MOVE_AMOUNT` bounds one run and may not be zero.
SECRET_IDLE_TARGET_WORKING_BPS=8000
SECRET_IDLE_MIN_IDLE_AMOUNT=100000000
SECRET_IDLE_MIN_MOVE_AMOUNT=25000000
SECRET_IDLE_MIN_MOVE_BPS=50
SECRET_IDLE_MIN_SUPPLY_RATE_RAY=0
SECRET_IDLE_MAX_MOVE_AMOUNT=1000000000000
SECRET_IDLE_EXPIRY=1791244800

# --- the agent key, for `delivery: signature` ---------------------------
# The enclave signs an EIP-712 statement about the move with this and hands it
# out with the calldata for any relayer to carry. On a real deployment it is a
# Vault DON secret that exists nowhere else; here it is anvil's second account,
# which is what `config.staging.json` names as the agent.
SECRET_AGENT_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- the model that explains the verdict --------------------------------
# A language model turns the decision into a sentence the owner can read. It decides nothing:
# the enclave has already chosen and the account enforces the shape of the call regardless.
#
# It can only run here. A non-confidential workflow calls an endpoint from every node and takes
# a consensus of the answers; ten nodes asking a model the same question get ten different
# answers, and free text has no median. Inside the enclave the call happens once.
#
# Two layers, and they cannot share the `Authorization` header — sending the key as a bearer
# token replaces the Basic one and everything answers 401.
SECRET_AI_USERNAME=replace-me
SECRET_AI_PASSWORD=replace-me
SECRET_AI_API_KEY=sk-replace-me
