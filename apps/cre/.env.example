###############################################################################
### Copy to `.env` (gitignored) and fill in. DO NOT COMMIT OR SHARE `.env`.  ###
###############################################################################

# The key the CRE CLI broadcasts with when simulating with --broadcast. In a
# deployed Confidential Workflow the DON signs instead, and this is unused.
# For `rehearse.sh` this is anvil's first account, which is public knowledge
# and holds nothing on any real chain.
CRE_ETH_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CRE_TARGET=staging-settings

# --- the private half of the mandate ------------------------------------
# Read only inside the enclave. These must hash, with the pool id from the
# config, to the mandate the vault already holds — the vault refuses any
# verdict whose `keccak256(abi.encode(mandate))` is not the one it stored, so
# a wrong value here produces a refusal, never a wrong move.
#
# The values below are the ones `rehearse.sh` commits on the fork.
SECRET_MANDATE_RANGE_WIDTH_TICKS=200
SECRET_MANDATE_MIN_IMPROVEMENT_BPS=100
SECRET_MANDATE_COOLDOWN_SECONDS=3600
SECRET_MANDATE_MAX_LIQUIDITY=340282366920938463463374607431768211455
SECRET_MANDATE_EXPIRY=1791244800
SECRET_MANDATE_MIN_RETAINED_BPS=5000

# --- the agent key, for `delivery: signature` ---------------------------
# The enclave signs an EIP-712 authorisation with this and hands it to any
# relayer. On a real deployment it is a Vault DON secret that exists nowhere
# else; here it is anvil's second account.
SECRET_AGENT_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- the model that explains the verdict --------------------------------
# A language model turns the decision into a sentence the owner can read. It decides nothing:
# the enclave has already chosen and the vault re-checks every rule on chain.
#
# It can only run here. A non-confidential workflow calls an endpoint from every node and takes
# a consensus of the answers; ten nodes asking a model the same question get ten different
# answers, and free text has no median. Inside the enclave the call happens once.
#
# Two layers, and they cannot share the `Authorization` header — sending the key as a bearer
# token replaces the Basic one and everything answers 401.
SECRET_AI_USERNAME=replace-me
SECRET_AI_PASSWORD=replace-me
SECRET_AI_API_KEY=sk-replace-me
