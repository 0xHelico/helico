{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["tsconfig.base.json", "bun.lock"],
	"globalPassThroughEnv": ["ARBITRUM_RPC_URL", "GRAPH_STUDIO_URL", "RPC_URL"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"lint": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	}
}
