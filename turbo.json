{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["tsconfig.base.json", "bun.lock"],
	"globalPassThroughEnv": [
		"ARBITRUM_RPC_URL",
		"CONFIRM",
		"DOLLARS",
		"GRAPH_STUDIO_URL",
		"HELICO_TAKER",
		"MAKER_KEY",
		"ONEINCH_API_KEY",
		"RPC_URL",
		"TAKER_KEY"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"lint": {},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		}
	}
}
